// ---------------------------------------------------------------- 128-bit + fixed point
struct Wide { hi: u64, lo: u64 }

fn mulw(a: u64, b: u64) -> Wide {
    let m: u64 = 0xFFFF_FFFF;
    let a0 = a & m; let a1 = a >> 32; let b0 = b & m; let b1 = b >> 32;
    let p00 = a0 * b0; let p01 = a0 * b1; let p10 = a1 * b0; let p11 = a1 * b1;
    let mid = (p00 >> 32) + (p01 & m) + (p10 & m);
    return Wide { hi: p11 + (p01 >> 32) + (p10 >> 32) + (mid >> 32), lo: (mid << 32) | (p00 & m) };
}

// (a*b) >> s for 1 <= s <= 127, result assumed to fit in 64 bits
fn mulsh(a: u64, b: u64, s: u64) -> u64 {
    let w = mulw(a, b);
    if s >= 64 {
        if s == 64 { return w.hi; }
        return w.hi >> (s - 64);
    }
    return (w.hi << (64 - s)) | (w.lo >> s);
}

fn mulhi(a: u64, b: u64) -> u64 {
    let w = mulw(a, b);
    return w.hi;
}

fn mq(a: u64, b: u64) -> u64 { return mulsh(a, b, 62); }   // Q62 product
fn one62() -> u64 { return u64(1) << 62; }

// floor(a*b/d) through a 128-bit dividend (bitwise long division; d < 2^63)
fn muldiv(a: u64, b: u64, d: u64) -> u64 {
    let w = mulw(a, b);
    let q: u64 = 0;
    let r: u64 = 0;
    let i: u64 = 0;
    while i < 128 {
        let bit: u64 = 0;
        if i < 64 { bit = (w.hi >> (63 - i)) & 1; } else { bit = (w.lo >> (127 - i)) & 1; }
        r = (r << 1) | bit;
        q = q << 1;
        if r >= d { r = r - d; q = q | 1; }
        i = i + 1;
    }
    return q;
}

// floor(2^e / d), e <= 127
fn divpow2(e: u64, d: u64) -> u64 {
    let q: u64 = 0;
    let r: u64 = 0;
    let i: u64 = 0;
    while i <= e {
        let bit: u64 = 0;
        if i == 0 { bit = 1; }
        r = (r << 1) | bit;
        q = q << 1;
        if r >= d { r = r - d; q = q | 1; }
        i = i + 1;
    }
    return q;
}

// natural log in Q32 for x >= 1: log2 by repeated squaring of the Q62 mantissa, times ln 2
fn ln_q32(x: u64) -> u64 {
    if x <= 1 { return 0; }
    let n: u64 = 63;
    while ((x >> n) & 1) == 0 { n = n - 1; }
    let y: u64 = 0;
    if n <= 62 { y = x << (62 - n); } else { y = x >> 1; }
    let f: u64 = 0;
    let bit: u64 = u64(1) << 40;
    let two: u64 = u64(1) << 63;
    let i: u64 = 0;
    while i < 41 {
        y = mq(y, y);
        if y >= two { y = y >> 1; f = f | bit; }
        bit = bit >> 1;
        i = i + 1;
    }
    let lg = (n << 41) | f;                     // log2(x), Q41
    let ln2: u64 = 3196577161300663914;        // ln 2, Q62
    return mulsh(lg, ln2, 71);                  // Q41 * Q62 >> 71 = Q32
}

// ---------------------------------------------------------------- output buffer
struct Out { p: *u8, cap: u64, len: u64, fd: i32 }

fn out_new(fd: i32, cap: u64) -> Out {
    return Out { p: rt_alloc8(cap), cap: cap, len: 0, fd: fd };
}

fn flush(write o: Out) {
    if o.len > 0 {
        let s = slice(o.p, o.cap);
        mml_fd_write(o.fd, &s[0], o.len);
        o.len = 0;
    }
}

fn grow(write o: Out) {                       // in-memory buffers (fd < 0) double instead of flushing
    let nc = o.cap * 2;
    let np = rt_alloc8(nc);
    memcpy(np, o.p, o.len);
    rt_free(o.p);
    o.p = np;
    o.cap = nc;
}

fn pb(write o: Out, b: u8) {
    if o.len + 1 >= o.cap { if o.fd < 0 { grow(o); } else { flush(o); } }
    let s = slice(o.p, o.cap);
    s[o.len] = b;
    o.len = o.len + 1;
}

fn ps(write o: Out, t: str) {
    let i: u64 = 0;
    while i < t.len { pb(o, t.bytes[i]); i = i + 1; }
}

fn pu(write o: Out, n: u64) {
    let d: [24]u8;
    d[0] = 48;
    let k: u64 = 0;
    let m = n;
    if m == 0 { k = 1; }
    while m != 0 { d[k] = 48 + u8(m % 10); m = m / 10; k = k + 1; }
    while k > 0 { k = k - 1; pb(o, d[k]); }
}

fn pi(write o: Out, n: i64) {
    if n < 0 { pb(o, 45); pu(o, u64(0) - u64(n)); } else { pu(o, u64(n)); }
}

fn tab(write o: Out) { pb(o, 9); }

// fixed decimal: v / 2^f printed with nd decimals (f <= 60, integer part < 2^(64-f))
fn pfix(write o: Out, v: u64, f: u64, nd: u64) {
    // round: add half a unit in the last place
    let unit: u64 = 1;
    let k: u64 = 0;
    while k < nd { unit = unit * 10; k = k + 1; }
    let ip = v >> f;
    let fr = v & ((u64(1) << f) - 1);
    let scaled = (muldiv(fr, unit * 2, u64(1) << f) + 1) / 2;   // round half up
    if scaled >= unit { ip = ip + 1; scaled = scaled - unit; }
    pu(o, ip);
    if nd > 0 {
        pb(o, 46);
        let digs: [24]u8;
        digs[0] = 48;
        let j: u64 = 0;
        let s = scaled;
        while j < nd { digs[j] = 48 + u8(s % 10); s = s / 10; j = j + 1; }
        while j > 0 { j = j - 1; pb(o, digs[j]); }
    }
}

// scientific: v / 2^f as d.dddde-XX with nd decimals (like printf %.{nd}e)
fn psci(write o: Out, v: u64, f: u64, nd: u64) {
    if v == 0 {
        ps(o, "0.");
        let z: u64 = 0;
        while z < nd { pb(o, 48); z = z + 1; }
        ps(o, "e+00");
        return;
    }
    // integer part and 40 fractional decimal digits into a digit string
    let dg: [80]u8;
    dg[0] = 0;
    let n: u64 = 0;
    let ip = v >> f;
    let fr = v & ((u64(1) << f) - 1);
    let tmp: [24]u8;
    tmp[0] = 0;
    let ti: u64 = 0;
    let m = ip;
    while m != 0 { tmp[ti] = u8(m % 10); m = m / 10; ti = ti + 1; }
    let intdigits = ti;
    while ti > 0 { ti = ti - 1; dg[n] = tmp[ti]; n = n + 1; }
    // fraction digits: shift fr to Q60 so x10 never overflows
    let fr60: u64 = 0;
    if f >= 60 { fr60 = fr >> (f - 60); } else { fr60 = fr << (60 - f); }
    let mask60 = (u64(1) << 60) - 1;
    let k: u64 = 0;
    while k < 40 {
        fr60 = fr60 * 10;
        dg[n] = u8(fr60 >> 60);
        fr60 = fr60 & mask60;
        n = n + 1;
        k = k + 1;
    }
    // first significant digit
    let first: u64 = 0;
    while first < n && dg[first] == 0 { first = first + 1; }
    if first >= n { ps(o, "0.0000e+00"); return; }
    let exp: i64 = i64(intdigits) - 1 - i64(first);
    // round to nd+1 significant digits
    let last = first + nd;
    if last + 1 < n && dg[last + 1] >= 5 {
        let j = last;
        let carry = true;
        while carry {
            dg[j] = dg[j] + 1;
            if dg[j] == 10 {
                dg[j] = 0;
                if j == first {
                    // 9.999 -> 10.000: shift
                    if first == 0 { carry = false; dg[0] = 1; exp = exp + 1; } else { first = first - 1; dg[first] = 1; exp = exp + 1; carry = false; }
                } else { j = j - 1; }
            } else { carry = false; }
        }
    }
    pb(o, 48 + dg[first]);
    pb(o, 46);
    let t: u64 = 1;
    while t <= nd { pb(o, 48 + dg[first + t]); t = t + 1; }
    pb(o, 101);
    if exp < 0 { pb(o, 45); exp = 0 - exp; } else { pb(o, 43); }
    if exp < 10 { pb(o, 48); }
    pu(o, u64(exp));
}

// ---------------------------------------------------------------- parsing
fn isdig(b: u8) -> bool { return b >= 48 && b <= 57; }

// decimal "12.3456" at s[i..] -> Q32; advances nothing (caller finds tokens)
fn parse_q32(s: slice u8, lo: u64, hi: u64) -> u64 {
    let ip: u64 = 0;
    let i = lo;
    while i < hi && isdig(s[i]) { ip = ip * 10 + u64(s[i] - 48); i = i + 1; }
    let fr: u64 = 0;
    let den: u64 = 1;
    if i < hi && s[i] == 46 {
        i = i + 1;
        while i < hi && isdig(s[i]) && den < 1000000000000 { fr = fr * 10 + u64(s[i] - 48); den = den * 10; i = i + 1; }
    }
    return (ip << 32) + muldiv(fr, u64(1) << 32, den);
}

// "2.953504e-05" or "0" -> Q62 (values < 4)
fn parse_sci_q62(s: str) -> u64 { return parse_sci_s(s.bytes, 0, s.len); }

fn parse_sci_s(b: slice u8, lo: u64, hi: u64) -> u64 {
    let mant: u64 = 0;
    let fd: i64 = 0;
    let seen_dot = false;
    let i = lo;
    while i < hi && (isdig(b[i]) || b[i] == 46) {
        if b[i] == 46 { seen_dot = true; } else {
            if mant < 100000000000000000 { mant = mant * 10 + u64(b[i] - 48); if seen_dot { fd = fd + 1; } }
        }
        i = i + 1;
    }
    let ex: i64 = 0;
    if i < hi && (b[i] == 101 || b[i] == 69) {
        i = i + 1;
        let neg = false;
        if i < hi && b[i] == 45 { neg = true; i = i + 1; } else { if i < hi && b[i] == 43 { i = i + 1; } }
        while i < hi && isdig(b[i]) { ex = ex * 10 + i64(b[i] - 48); i = i + 1; }
        if neg { ex = 0 - ex; }
    }
    let k = fd - ex;                // value = mant / 10^k
    if mant == 0 { return 0; }
    if k > 36 { return 0; }
    let v = mant;
    let sh: u64 = 62;
    // value * 2^62 = mant * 2^62 / 10^k
    if k <= 0 {
        let j: i64 = 0;
        while j < 0 - k { v = v * 10; j = j + 1; }
        return v << 62;
    }
    // divide in two steps to keep 10^k inside u64
    let k1 = k;
    if k1 > 18 { k1 = 18; }
    let p1: u64 = 1;
    let j: i64 = 0;
    while j < k1 { p1 = p1 * 10; j = j + 1; }
    let r = muldiv(v, u64(1) << sh, p1);
    let k2 = k - k1;
    let p2: u64 = 1;
    j = 0;
    while j < k2 { p2 = p2 * 10; j = j + 1; }
    return r / p2;
}

// "1e9", "4000000000", "15" -> integer
fn parse_num(s: str) -> u64 {
    let b = s.bytes;
    let v: u64 = 0;
    let i: u64 = 0;
    while i < b.len && isdig(b[i]) { v = v * 10 + u64(b[i] - 48); i = i + 1; }
    if i < b.len && b[i] == 46 {           // skip fraction for integer contexts
        i = i + 1;
        while i < b.len && isdig(b[i]) { i = i + 1; }
    }
    if i < b.len && (b[i] == 101 || b[i] == 69) {
        i = i + 1;
        let e: u64 = 0;
        while i < b.len && isdig(b[i]) { e = e * 10 + u64(b[i] - 48); i = i + 1; }
        let k: u64 = 0;
        while k < e { v = v * 10; k = k + 1; }
    }
    return v;
}

fn arg_or(i: i64, dflt: str) -> str {
    // (a match whose arms all `return` a str trips a codegen bug in ourc 0.2.0 -- see NOTES)
    let r = dflt;
    let a = process.arg(i);
    match a {
        Ok(x) => { r = x; }
        Err(e) => {}
    }
    return r;
}

// ---------------------------------------------------------------- records table
struct Rec { p: *u64, max: u64 }

fn load_records(path: str) -> Rec {
    let heap = system_allocator();
    let data = fs.slurp(heap, path.bytes.ptr);
    let rp = rt_alloc64(1);
    let mx: u64 = 0;
    if true {
    let s = data.as_slice();
    // pass 1: max gap
    let i: u64 = 0;
    while i < s.len {
        let g: u64 = 0;
        while i < s.len && isdig(s[i]) { g = g * 10 + u64(s[i] - 48); i = i + 1; }
        if g > mx { mx = g; }
        while i < s.len && s[i] != 10 { i = i + 1; }
        i = i + 1;
    }
    rp = rt_alloc64(mx + 1);
    let rec = slice(rp, mx + 1);
    i = 0;
    while i < s.len {
        let g: u64 = 0;
        while i < s.len && isdig(s[i]) { g = g * 10 + u64(s[i] - 48); i = i + 1; }
        while i < s.len && s[i] == 32 { i = i + 1; }
        let lo = i;
        while i < s.len && s[i] != 10 && s[i] != 32 { i = i + 1; }
        if g > 0 && g <= mx { rec[g] = parse_q32(s, lo, i); }
        while i < s.len && s[i] != 10 { i = i + 1; }
        i = i + 1;
    }
    }
    data.destroy();
    return Rec { p: rp, max: mx };
}

// ---------------------------------------------------------------- primes
struct Primes { p: *u32, n: u64, lprod: u64 }       // lprod = prod (1 - 1/p), Q62

fn sieve_primes(L: u64) -> Primes {
    let r: u64 = 2;
    while r * r <= L { r = r + 1; }
    let sp = rt_alloc8(r + 1);
    let small = slice(sp, r + 1);
    let bp = rt_alloc32(r + 1);
    let base = slice(bp, r + 1);
    let nb: u64 = 0;
    let i: u64 = 2;
    while i <= r {
        if small[i] == 0 {
            base[nb] = u32(i); nb = nb + 1;
            let j = i * i;
            while j <= r { small[j] = 1; j = j + i; }
        }
        i = i + 1;
    }
    // capacity: pi(x) < 1.26 x / ln x; use x/ (ln x - 1.1) like the C version
    let lnL = ln_q32(L) >> 32;
    let cap = L / (lnL - 1) + 1000;
    let pp = rt_alloc32(cap);
    let out = slice(pp, cap);
    let cnt: u64 = 0;
    let SEG: u64 = 1 << 22;
    let gp = rt_alloc8(SEG);
    let seg = slice(gp, SEG);
    let lo: u64 = 2;
    let lprod = one62();
    while lo <= L {
        let hi = lo + SEG - 1;
        if hi > L { hi = L; }
        rt_zero(gp, SEG);
        let k: u64 = 0;
        while k < nb {
            let p = u64(base[k]);
            if p * p > hi { break; }
            let st = (lo + p - 1) / p * p;
            if st < p * p { st = p * p; }
            while st <= hi { seg[st - lo] = 1; st = st + p; }
            k = k + 1;
        }
        let j = lo;
        while j <= hi {
            if seg[j - lo] == 0 {
                out[cnt] = u32(j); cnt = cnt + 1;
                lprod = lprod - lprod / j;           // *= (1 - 1/p), exact to Q62 rounding
            }
            j = j + 1;
        }
        lo = hi + 1;
    }
    rt_free(sp); rt_free(bp); rt_free(gp);
    return Primes { p: pp, n: cnt, lprod: lprod };
}

// ---------------------------------------------------------------- modular search
// smallest x >= 0 with l <= (a*x) mod m <= r  (0 <= l <= r < m < 2^32). -1 if none.
fn msearch(a0: u64, m: u64, l: u64, r: u64) -> i64 {
    if l == 0 { return 0; }
    let a = a0 % m;
    if a == 0 { return -1; }
    let k = (l + a - 1) / a;
    if a * k <= r { return i64(k); }
    let nl = (a - r % a) % a;
    let nr = (a - l % a) % a;
    let y: i64 = 0;
    if nl <= nr { y = msearch(m % a, a, nl, nr); }
    if y < 0 { return -1; }
    while true {
        let yy = u64(y);
        let x = (m * yy + l + a - 1) / a;
        if a * x <= m * yy + r { return i64(x); }
        if yy > a { return -1; }
        y = y + 1;
    }
    return -1;
}

// ---------------------------------------------------------------- the engine
struct Ctx {
    P: u64, d: u64, m0: u64, M: u64, SL: u64, L: u64,
    lam: u64, mcal: u64, dry: bool,
    K: *void, N: *void, T: *void,
    lnK: u64,
    pr: *u32, np: u64, lprod: u64, kr: *u32,
    rec: *u64, recmax: u64,
    // scratch
    bits: *u64, words: u64, MB: u64,
    R: *u32, Lf: *u32, cntL: *u32, pw: *u64, imp: *u8,
    // stats
    tprp: u64, prp_n: u64, prp_t: u64,
    gpu: u64, nl: u64,
    ncand: u64, ntested: u64, ncomplete: u64, nhits: u64,
    sum_score: u64, value: u64, sum_pcal: u64, calhits: u64,   // sums in Q40
    t_pre: u64, t_sieve: u64, t_score: u64, t_test: u64
}

fn gcd64(a0: u64, b0: u64) -> u64 {
    let a = a0; let b = b0;
    while b != 0 { let t = a % b; a = b; b = t; }
    return a;
}

fn engine_setup(write c: Ctx, recpath: str) {
    let t0 = rt_now_ns();
    let rc = load_records(recpath);
    c.rec = rc.p; c.recmax = rc.max;
    let ps = sieve_primes(c.L);
    c.pr = ps.p; c.np = ps.n; c.lprod = ps.lprod;
    c.K = rt_mpz(); c.N = rt_mpz(); c.T = rt_mpz();
    __gmpz_primorial_ui(c.K, c.P);
    if __gmpz_divisible_ui_p(c.K, c.d) == 0 { io.eprintln("d must divide P#"); process.exit(1); }
    __gmpz_divexact_ui(c.K, c.K, c.d);
    // ln K = sum ln p (p <= P) - ln d
    let pr = slice(c.pr, c.np);
    let s: u64 = 0;
    let i: u64 = 0;
    while i < c.np && u64(pr[i]) <= c.P { s = s + ln_q32(u64(pr[i])); i = i + 1; }
    c.lnK = s - ln_q32(c.d);
    c.kr = rt_alloc32(c.np);
    let kr = slice(c.kr, c.np);
    i = 0;
    while i < c.np { kr[i] = u32(__gmpz_fdiv_ui(c.K, u64(pr[i]))); i = i + 1; }
    c.t_pre = rt_now_ns() - t0;
    // PRP timing on numbers of this size with no small factor
    let g = rt_mpz(); let sp = rt_mpz();
    __gmpz_primorial_ui(sp, 2000);
    __gmpz_mul_ui(c.T, c.K, c.m0);
    __gmpz_add_ui(c.T, c.T, 1);
    if rt_mpz_odd(c.T) == 0 { __gmpz_add_ui(c.T, c.T, 1); }
    let done: u64 = 0;
    let ta = rt_now_ns();
    let guard: u64 = 0;
    while done < 3 && guard < 100000 {
        __gmpz_gcd(g, c.T, sp);
        if __gmpz_cmp_ui(g, 1) == 0 { __gmpz_probab_prime_p(c.T, 1); done = done + 1; }
        __gmpz_add_ui(c.T, c.T, 2);
        guard = guard + 1;
    }
    c.tprp = (rt_now_ns() - ta) / 3;
    rt_mpz_free(g); rt_mpz_free(sp);
    // limb count for the gpu packing: room for K * (m0 + M) + SL
    __gmpz_mul_ui(c.T, c.K, c.m0 + c.M + 1);
    c.nl = u64(rt_mpz_bits(c.T)) / 32 + 1;
    // scratch
    c.words = (c.SL + 64) / 64 + 1;
    let mb = 64000000 / (2 * c.words * 8);
    if mb < 1 { mb = 1; }
    if mb > c.M { mb = c.M; }
    c.MB = mb;
    c.bits = rt_alloc64(mb * 2 * c.words);
    c.R = rt_alloc32(c.SL + 2);
    c.Lf = rt_alloc32(c.SL + 2);
    c.cntL = rt_alloc32(c.SL + 3);
    c.pw = rt_alloc64(c.SL + 3);
    c.imp = rt_alloc8(2 * c.SL + 4);
}

fn setbit(b: slice mut u64, i: u64) { b[i >> 6] = b[i >> 6] | (u64(1) << (i & 63)); }

// strike every offset of every center in [mstart, mstart+mb) that has a prime factor <= L
fn sieve_block(write c: Ctx, mstart: u64, mb: u64) {
    let W = c.words;
    rt_zero(c.bits, mb * 2 * W * 8);
    let bits = slice(c.bits, mb * 2 * W);
    let pr = slice(c.pr, c.np);
    let kr = slice(c.kr, c.np);
    let SL = c.SL;
    let i: u64 = 0;
    while i < c.np {
        let p = u64(pr[i]);
        let a = u64(kr[i]);
        let hits_x = mb * (2 * SL + 1);               // hits ~ hits_x / p
        if p <= 2 * SL + 1 || 3 * (hits_x / p + 1) >= mb {
            let mr = mstart % p;
            let k: u64 = 0;
            while k < mb {
                let r = (mr * a) % p;
                let rt = k * 2 * W;
                let lf = rt + W;
                let s = (p - r) % p;
                if s == 0 { s = p; }
                while s <= SL { bits[rt + (s >> 6)] = bits[rt + (s >> 6)] | (u64(1) << (s & 63)); s = s + p; }
                s = r;
                if s == 0 { s = p; }
                while s <= SL { bits[lf + (s >> 6)] = bits[lf + (s >> 6)] | (u64(1) << (s & 63)); s = s + p; }
                mr = mr + 1;
                if mr == p { mr = 0; }
                k = k + 1;
            }
        } else {
            let B = ((mstart % p) * a) % p;
            let k: u64 = 0;
            while k < mb {
                let Bk = (B + a * k) % p;
                let lo = (p - SL % p + p - Bk) % p;
                let hi = (lo + 2 * SL) % p;
                let x: i64 = 0;
                if lo <= hi { x = msearch(a, p, lo, hi); } else {
                    let x1 = msearch(a, p, lo, p - 1);
                    let x2 = msearch(a, p, 0, hi);
                    if x1 < 0 { x = x2; } else { if x2 < 0 { x = x1; } else { if x1 < x2 { x = x1; } else { x = x2; } } }
                }
                if x < 0 { break; }
                k = k + u64(x);
                if k >= mb { break; }
                let r = (B + a * k) % p;
                let rt = k * 2 * W;
                let lf = rt + W;
                if r == 0 {
                    if p <= SL { bits[rt + (p >> 6)] = bits[rt + (p >> 6)] | (u64(1) << (p & 63)); bits[lf + (p >> 6)] = bits[lf + (p >> 6)] | (u64(1) << (p & 63)); }
                } else {
                    if r >= p - SL {
                        let o = p - r;
                        bits[rt + (o >> 6)] = bits[rt + (o >> 6)] | (u64(1) << (o & 63));
                    } else {
                        if r <= SL { bits[lf + (r >> 6)] = bits[lf + (r >> 6)] | (u64(1) << (r & 63)); }
                    }
                }
                k = k + 1;
            }
        }
        i = i + 1;
    }
}

fn q40(v: u64) -> u64 { return v >> 22; }   // Q62 -> Q40 accumulator scale

fn improves(rec: slice u64, recmax: u64, g: u64, lnN: u64) -> bool {
    if g > recmax { return true; }
    return g > mulhi(rec[g], lnN);            // g/lnN > rec  <=>  g > rec*lnN (both Q32 -> hi word)
}

fn merit_e4(g: u64, lnN: u64) -> u64 { return (muldiv(g * 20000, u64(1) << 32, lnN) + 1) / 2; }

fn pmerit(write o: Out, m4: u64) {
    pu(o, m4 / 10000); pb(o, 46);
    let f = m4 % 10000;
    if f < 1000 { pb(o, 48); } if f < 100 { pb(o, 48); } if f < 10 { pb(o, 48); }
    pu(o, f);
}

fn prec4(write o: Out, rq32: u64) {                 // record merit (Q32) as %.4f
    pfix(o, rq32 >> 2, 30, 4);
}

fn psec(write o: Out, ns: u64, nd: u64) {          // nanoseconds as seconds, nd decimals
    let unit: u64 = 1000000000;
    let k: u64 = 0;
    let dv: u64 = 1;
    while k < 9 - nd { dv = dv * 10; k = k + 1; }
    let v = (ns + dv / 2) / dv;
    let sc: u64 = 1;
    k = 0;
    while k < nd { sc = sc * 10; k = k + 1; }
    pu(o, v / sc);
    if nd > 0 {
        pb(o, 46);
        let f = v % sc;
        let t = sc / 10;
        while t > 1 && f < t { pb(o, 48); t = t / 10; }
        pu(o, f);
    }
}


// ---------------------------------------------------------------- one result line
fn put_T(write o: Out, m: u64, lnN: u64, sc: u64, scb: u64, completed: bool, a: i64, b: i64, gap: u64,
         m4: u64, rq: u64, tr: u64, tl: u64, pcal: u64, hitcal: u64, hit: u64, dt: u64,
         scal0: u64, q: u64, vpol: u64, cpol_ns: u64) {
    ps(o, "T\t"); pu(o, m); tab(o);
    pu(o, lnN / 9889527665 + 1); tab(o);
    psci(o, sc, 62, 4); tab(o); psci(o, scb, 62, 4); tab(o);
    if completed { pb(o, 49); } else { pb(o, 48); }
    tab(o);
    pi(o, a); tab(o); pi(o, b); tab(o); pu(o, gap); tab(o);
    pmerit(o, m4); tab(o); prec4(o, rq); tab(o);
    pu(o, tr); tab(o); pu(o, tl); tab(o);
    pfix(o, pcal >> 2, 60, 5); tab(o); pu(o, hitcal); tab(o); pu(o, hit); tab(o);
    psec(o, dt, 3); tab(o); psci(o, scal0, 62, 6); tab(o); psci(o, q, 62, 6); tab(o);
    psci(o, vpol, 62, 6); tab(o); psec(o, cpol_ns, 3);
    pb(o, 10);
    flush(o);
}

// ---------------------------------------------------------------- the wavefront (gpu) tester
// candidates that pass the gate are parked in a group; the group is tested in rounds where every
// active candidate contributes its next CH survivors, so one gpu dispatch carries ~G*CH numbers.
struct Grp {
    G: u64, CAPS: u64, n: u64, IMPN: u64, CH: u64,
    m: *u64, lnN: *u64, q: *u64, Gc: *u64, eL: *u64, nR: *u64, nL: *u64,
    st: *u64, idx: *u64, b: *u64, a: *u64, tr: *u64, tl: *u64, comp: *u64,
    scb: *u64, pcal: *u64, sc: *u64, scal0: *u64, vpol: *u64, cpol: *u64, pwnL: *u64,
    R: *u32, Lf: *u32, imp: *u8,
    nums: *u32, rmods: *u32, res: *u8, own: *u64, cntk: *u64, BMAX: u64, t0: u64
}

fn grp_new(G: u64, SL: u64, nl: u64) -> Grp {
    let caps = SL / 8 + 256;
    let ch: u64 = 16;
    let bmax = G * ch;
    return Grp {
        G: G, CAPS: caps, n: 0, IMPN: 2 * SL + 4, CH: ch,
        m: rt_alloc64(G), lnN: rt_alloc64(G), q: rt_alloc64(G), Gc: rt_alloc64(G), eL: rt_alloc64(G),
        nR: rt_alloc64(G), nL: rt_alloc64(G), st: rt_alloc64(G), idx: rt_alloc64(G), b: rt_alloc64(G),
        a: rt_alloc64(G), tr: rt_alloc64(G), tl: rt_alloc64(G), comp: rt_alloc64(G),
        scb: rt_alloc64(G), pcal: rt_alloc64(G), sc: rt_alloc64(G), scal0: rt_alloc64(G),
        vpol: rt_alloc64(G), cpol: rt_alloc64(G), pwnL: rt_alloc64(G),
        R: rt_alloc32(G * caps), Lf: rt_alloc32(G * caps), imp: rt_alloc8(G * (2 * SL + 4)),
        nums: rt_alloc32(bmax * nl), rmods: rt_alloc32(bmax * nl), res: rt_alloc8(bmax),
        own: rt_alloc64(bmax), cntk: rt_alloc64(G), BMAX: bmax, t0: 0
    };
}

// side: 0 = right (N + off), 1 = left (N - off). returns true if a probable prime was confirmed.
fn grp_finish_one(write c: Ctx, write g: Grp, write o: Out, i: u64, dt: u64) {
    let gm = slice(g.m, g.G); let glnN = slice(g.lnN, g.G); let gq = slice(g.q, g.G);
    let gb = slice(g.b, g.G); let ga = slice(g.a, g.G); let gtr = slice(g.tr, g.G); let gtl = slice(g.tl, g.G);
    let gcomp = slice(g.comp, g.G); let gscb = slice(g.scb, g.G); let gpcal = slice(g.pcal, g.G);
    let gsc = slice(g.sc, g.G); let gscal0 = slice(g.scal0, g.G); let gvpol = slice(g.vpol, g.G);
    let gcpol = slice(g.cpol, g.G); let gGc = slice(g.Gc, g.G);
    let rec = slice(c.rec, c.recmax + 1);
    let imp = slice(g.imp, g.G * g.IMPN);
    let completed = gcomp[i] == 1;
    let gap: u64 = 0; let m4: u64 = 0; let rq: u64 = 0; let hitcal: u64 = 0; let hit: u64 = 0;
    let av: i64 = -1; let bv: i64 = -1;
    if gb[i] != 0 { bv = i64(gb[i]); }
    if completed {
        av = i64(ga[i]);
        gap = ga[i] + gb[i];
        m4 = merit_e4(gap, glnN[i]);
        if gap <= c.recmax { rq = rec[gap]; }
        if gap >= gGc[i] { hitcal = 1; }
        c.ncomplete = c.ncomplete + 1;
        c.value = c.value + q40(gscb[i]);
        c.sum_pcal = c.sum_pcal + q40(gpcal[i]);
        c.calhits = c.calhits + hitcal;
        if imp[i * g.IMPN + gap] == 1 {
            __gmpz_mul_ui(c.N, c.K, gm[i]);
            __gmpz_add_ui(c.T, c.N, gb[i]);
            let ok1 = __gmpz_probab_prime_p(c.T, 25);
            __gmpz_sub_ui(c.T, c.N, ga[i]);
            let ok2 = __gmpz_probab_prime_p(c.T, 25);
            if ok1 != 0 && ok2 != 0 { hit = 1; c.nhits = c.nhits + 1; }
        }
    }
    put_T(o, gm[i], glnN[i], gsc[i], gscb[i], completed, av, bv, gap, m4, rq, gtr[i], gtl[i],
          gpcal[i], hitcal, hit, dt, gscal0[i], gq[i], gvpol[i], gcpol[i]);
}

fn grp_run(write c: Ctx, write g: Grp, write o: Out) {
    if g.n == 0 { return; }
    let t0 = rt_now_ns();
    let n = g.n;
    let G = g.G;
    let gm = slice(g.m, G); let gq = slice(g.q, G); let geL = slice(g.eL, G);
    let gnR = slice(g.nR, G); let gnL = slice(g.nL, G); let gst = slice(g.st, G); let gidx = slice(g.idx, G);
    let gb = slice(g.b, G); let ga = slice(g.a, G); let gtr = slice(g.tr, G); let gtl = slice(g.tl, G);
    let gcomp = slice(g.comp, G); let gscb = slice(g.scb, G); let gpcal = slice(g.pcal, G);
    let gpw = slice(g.pwnL, G); let gGc = slice(g.Gc, G); let gcnt = slice(g.cntk, G);
    let gR = slice(g.R, G * g.CAPS); let gL = slice(g.Lf, G * g.CAPS);
    let imp = slice(g.imp, G * g.IMPN);
    let nums = slice(g.nums, g.BMAX * c.nl);
    let rmods = slice(g.rmods, g.BMAX * c.nl);
    let res = slice(g.res, g.BMAX);
    let ONE = one62();
    let tests_total: u64 = 0;
    let finished_at = rt_alloc64(G);
    let fin = slice(finished_at, G);
    let active = true;
    while active {
        // build one wavefront
        let cnt: u64 = 0;
        let i: u64 = 0;
        while i < n {
            gcnt[i] = 0;
            if gst[i] == 0 || gst[i] == 1 {
                let side = gst[i];
                let lim = gnR[i];
                if side == 1 { lim = gnL[i]; }
                if lim > g.CAPS { lim = g.CAPS; }
                if gidx[i] >= lim {
                    gst[i] = 2;                            // exhausted the window without a prime
                    fin[i] = rt_now_ns();
                } else {
                    __gmpz_mul_ui(c.N, c.K, gm[i]);
                    let k: u64 = 0;
                    while k < g.CH && gidx[i] + k < lim {
                        let off: u64 = 0;
                        if side == 0 { off = u64(gR[i * g.CAPS + gidx[i] + k]); __gmpz_add_ui(c.T, c.N, off); }
                        else { off = u64(gL[i * g.CAPS + gidx[i] + k]); __gmpz_sub_ui(c.T, c.N, off); }
                        rt_pack(c.T, &mut nums[cnt * c.nl], &mut rmods[cnt * c.nl], i32(c.nl));
                        cnt = cnt + 1;
                        k = k + 1;
                    }
                    gcnt[i] = k;
                }
            }
            i = i + 1;
        }
        if cnt == 0 { active = false; break; }
        if c.gpu == 2 { rt_cpu_fermat_batch(&mut nums[0], &mut rmods[0], i32(c.nl), i32(cnt), &mut res[0]); }
        else {
            let used = rt_gpu_fermat_batch(&mut nums[0], &mut rmods[0], i32(c.nl), i32(cnt), &mut res[0]);
            if used < 0 {
                // never trust a failed dispatch: a prime reported as composite would fake a longer gap.
                // redo the batch with the exact cpu path and say so on stderr (the server ignores it)
                io.eprintln("hunter: gpu dispatch failed, redoing this batch on the cpu (gmp)");
                rt_gmp_fermat_batch(&mut nums[0], &mut rmods[0], i32(c.nl), i32(cnt), &mut res[0]);
            }
        }
        tests_total = tests_total + cnt;
        // read the wavefront back in the same order
        let pos: u64 = 0;
        i = 0;
        while i < n {
            let k = gcnt[i];
            if k > 0 {
                let side = gst[i];
                let found = false;
                let t: u64 = 0;
                while t < k {
                    if res[pos + t] == 1 {
                        // base-2 fermat said prime: confirm with gmp (bpsw) like the cpu path
                        let off: u64 = 0;
                        __gmpz_mul_ui(c.N, c.K, gm[i]);
                        if side == 0 { off = u64(gR[i * g.CAPS + gidx[i] + t]); __gmpz_add_ui(c.T, c.N, off); }
                        else { off = u64(gL[i * g.CAPS + gidx[i] + t]); __gmpz_sub_ui(c.T, c.N, off); }
                        if __gmpz_probab_prime_p(c.T, 1) != 0 {
                            found = true;
                            if side == 0 { gb[i] = off; gtr[i] = gidx[i] + t + 1; } else { ga[i] = off; gtl[i] = gidx[i] + t + 1; }
                            break;
                        }
                    }
                    t = t + 1;
                }
                if !found {
                    gidx[i] = gidx[i] + k;
                    if side == 0 { gtr[i] = gidx[i]; } else { gtl[i] = gidx[i]; }
                } else {
                    if side == 0 {
                        // conditional score given the next prime, then the one-sided skip decision
                        let b = gb[i];
                        let omq = ONE - gq[i];
                        let wl = gq[i];
                        let tiny = ONE / 100000000000000;
                        let scb: u64 = 0; let pcal: u64 = 0;
                        let jq: u64 = 0;
                        let lim = gnL[i];
                        if lim > g.CAPS { lim = g.CAPS; }
                        while jq < lim {
                            if wl < tiny { break; }
                            let gg = b + u64(gL[i * g.CAPS + jq]);
                            if imp[i * g.IMPN + gg] == 1 { scb = scb + wl; }
                            if gg >= gGc[i] { pcal = pcal + wl; }
                            wl = mq(wl, omq);
                            jq = jq + 1;
                        }
                        scb = scb + gpw[i];
                        pcal = pcal + gpw[i];
                        gscb[i] = scb; gpcal[i] = pcal;
                        let tp = c.tprp;
                        if c.prp_n > 40 { tp = c.prp_t / c.prp_n; }
                        if scb >= mulsh(muldiv(c.lam, tp, 1000000000), geL[i], 32) {
                            gst[i] = 1; gidx[i] = 0;
                        } else {
                            gst[i] = 2; fin[i] = rt_now_ns();
                        }
                    } else {
                        gcomp[i] = 1; gst[i] = 2; fin[i] = rt_now_ns();
                    }
                }
            }
            pos = pos + k;
            i = i + 1;
        }
    }
    let wall = rt_now_ns() - t0;
    c.prp_n = c.prp_n + tests_total;
    c.prp_t = c.prp_t + wall;
    c.t_test = c.t_test + wall;
    let i2: u64 = 0;
    while i2 < n {
        let dt = wall / n;
        grp_finish_one(c, g, o, i2, dt);
        i2 = i2 + 1;
    }
    rt_free(finished_at);
    g.n = 0;
}

// park a gated candidate in the group (copies its survivors and its improves-table)
fn grp_add(write g: Grp, m: u64, lnN: u64, q: u64, Gc: u64, eL: u64, nR: u64, nL: u64, sc: u64, scal0: u64,
           vpol: u64, cpol_ns: u64, pwnL: u64, R: slice u32, Lf: slice u32, imp: slice u8) {
    let i = g.n;
    let G = g.G;
    slice(g.m, G)[i] = m; slice(g.lnN, G)[i] = lnN; slice(g.q, G)[i] = q; slice(g.Gc, G)[i] = Gc;
    slice(g.eL, G)[i] = eL; slice(g.nR, G)[i] = nR; slice(g.nL, G)[i] = nL; slice(g.sc, G)[i] = sc;
    slice(g.scal0, G)[i] = scal0; slice(g.vpol, G)[i] = vpol; slice(g.cpol, G)[i] = cpol_ns;
    slice(g.pwnL, G)[i] = pwnL; slice(g.st, G)[i] = 0; slice(g.idx, G)[i] = 0; slice(g.b, G)[i] = 0;
    slice(g.a, G)[i] = 0; slice(g.tr, G)[i] = 0; slice(g.tl, G)[i] = 0; slice(g.comp, G)[i] = 0;
    slice(g.scb, G)[i] = 0; slice(g.pcal, G)[i] = 0;
    let gR = slice(g.R, G * g.CAPS); let gL = slice(g.Lf, G * g.CAPS);
    let k: u64 = 0;
    let lr = nR; if lr > g.CAPS { lr = g.CAPS; }
    while k < lr { gR[i * g.CAPS + k] = R[k]; k = k + 1; }
    let ll = nL; if ll > g.CAPS { ll = g.CAPS; }
    k = 0;
    while k < ll { gL[i * g.CAPS + k] = Lf[k]; k = k + 1; }
    let gi = slice(g.imp, G * g.IMPN);
    memcpy(&mut gi[i * g.IMPN], &imp[0], g.IMPN);
    g.n = i + 1;
}

fn run_engine(write c: Ctx, write o: Out) {
    let t0 = rt_now_ns();
    let rec = slice(c.rec, c.recmax + 1);
    let R = slice(c.R, c.SL + 2);
    let Lf = slice(c.Lf, c.SL + 2);
    let cntL = slice(c.cntL, c.SL + 3);
    let pw = slice(c.pw, c.SL + 3);
    let imp = slice(c.imp, 2 * c.SL + 4);
    let ONE = one62();
    let SL = c.SL;
    // A fixed gap can only cease improving as ln(N) increases. Cache every
    // invariant decision over this job; only endpoint disagreements need work.
    // HUNT_MASK_REFERENCE retains the full scan for differential validation.
    let mask_reference = false;
    match process.env("HUNT_MASK_REFERENCE") { Ok(v) => { mask_reference = true; } Err(e) => {} }
    let changing_ptr = rt_alloc32(2 * SL + 4);
    let changing = slice(changing_ptr, 2 * SL + 4);
    let nchanging: u64 = 0;
    let G0: u64 = 0;
    if !mask_reference && c.M > 0 {
        let mask_start = rt_now_ns();
        let ln_first = c.lnK + ln_q32(c.m0);
        let ln_last = c.lnK + ln_q32(c.m0 + c.M - 1);
        let g: u64 = 0;
        while g <= 2 * SL + 1 {
            let first = improves(rec, c.recmax, g, ln_first);
            let last = improves(rec, c.recmax, g, ln_last);
            if first { imp[g] = 1; } else { imp[g] = 0; }
            if (first && !last) || (!first && last) { changing[nchanging] = u32(g); nchanging = nchanging + 1; }
            if first && G0 == 0 && g >= 2 && (g & 1) == 0 { G0 = g; }
            g = g + 1;
        }
        if G0 == 0 { G0 = 2 * SL; }
        c.t_score = c.t_score + (rt_now_ns() - mask_start);
    }
    let G: u64 = 1;
    if c.gpu == 2 { G = 64; }      // cpu reference wavefront (validation)
    if c.gpu == 1 { G = 256; }     // metal: 256 centers x 16 survivors = 4096 tests per dispatch fills an M-series gpu
    let grp = grp_new(G, c.SL, c.nl + 1);
    let b0: u64 = 0;
    while b0 < c.M {
        let mb = c.M - b0;
        if mb > c.MB { mb = c.MB; }
        let mstart = c.m0 + b0;
        let ts = rt_now_ns();
        sieve_block(c, mstart, mb);
        c.t_sieve = c.t_sieve + (rt_now_ns() - ts);
        let bits = slice(c.bits, mb * 2 * c.words);
        let k: u64 = 0;
        while k < mb {
            let m = mstart + k;
            if gcd64(m, c.d) != 1 { k = k + 1; continue; }
            c.ncand = c.ncand + 1;
            let t1 = rt_now_ns();
            let rt = k * 2 * c.words;
            let lf = rt + c.words;
            let nR: u64 = 0;
            let nL: u64 = 0;
            if mask_reference {
            let off: u64 = 1;
            while off <= SL {
                if ((bits[rt + (off >> 6)] >> (off & 63)) & 1) == 0 { R[nR] = u32(off); nR = nR + 1; }
                if ((bits[lf + (off >> 6)] >> (off & 63)) & 1) == 0 { Lf[nL] = u32(off); nL = nL + 1; }
                off = off + 1;
            }
            } else {
                nR = rt_survivors(c.bits, rt, SL, c.R);
                nL = rt_survivors(c.bits, lf, SL, c.Lf);
            }
            let lnN = c.lnK + ln_q32(m);
            let D = mulsh(lnN, c.lprod, 62);              // lnN * prod, Q32
            let q = divpow2(94, D);                       // 1 / (lnN * prod), Q62
            let omq = ONE - q;
            let nmax = nR;
            if nL > nmax { nmax = nL; }
            pw[0] = ONE;
            let j: u64 = 1;
            while j <= nmax { pw[j] = mq(pw[j - 1], omq); j = j + 1; }
            // which gap sizes would beat the table at this ln N
            if mask_reference {
                G0 = 0;
                let g: u64 = 0;
                while g <= 2 * SL + 1 {
                    if improves(rec, c.recmax, g, lnN) { imp[g] = 1; if G0 == 0 && g >= 2 && (g & 1) == 0 { G0 = g; } } else { imp[g] = 0; }
                    g = g + 1;
                }
                if G0 == 0 { G0 = 2 * SL; }
            } else {
                let ci: u64 = 0;
                while ci < nchanging {
                    let g = u64(changing[ci]);
                    if improves(rec, c.recmax, g, lnN) { imp[g] = 1; } else { imp[g] = 0; }
                    ci = ci + 1;
                }
                while G0 < 2 * SL && imp[G0] == 0 { G0 = G0 + 2; }
            }
            // cntL[x] = #left survivors with offset < x
            let jj: u64 = 0;
            let x: u64 = 0;
            while x <= SL + 1 {
                while jj < nL && u64(Lf[jj]) < x { jj = jj + 1; }
                cntL[x] = u32(jj);
                x = x + 1;
            }
            // s0 = P(gap >= G0), the cheap upper bound
            let s0: u64 = 0;
            let w = q;
            let i: u64 = 0;
            while i < nR {
                let need = i64(G0) - i64(R[i]);
                let tail = ONE;
                if need > 1 { if u64(need) > SL + 1 { tail = pw[nL]; } else { tail = pw[cntL[u64(need)]]; } }
                s0 = s0 + mq(w, tail);
                w = mq(w, omq);
                if w == 0 { break; }
                i = i + 1;
            }
            // pre-test P(merit >= mcal)
            let Gc = mulhi(c.mcal, lnN) + 1;              // ceil(mcal * lnN)
            let scal0: u64 = 0;
            w = q;
            i = 0;
            while i < nR {
                let need = i64(Gc) - i64(R[i]);
                let tail = ONE;
                if need > 1 { if u64(need) > SL + 1 { tail = pw[nL]; } else { tail = pw[cntL[u64(need)]]; } }
                scal0 = scal0 + mq(w, tail);
                w = mq(w, omq);
                if w == 0 { break; }
                i = i + 1;
            }
            let qs = q >> 32;
            let eR = (ONE - pw[nR]) / qs;                 // expected PRP tests, Q32
            let eL = (ONE - pw[nL]) / qs;
            let tp = c.tprp;
            if c.prp_n > 40 { tp = c.prp_t / c.prp_n; }
            let lamt = muldiv(c.lam, tp, 1000000000);    // improvements per test, Q62
            let sc: u64 = 0;
            let vpol: u64 = 0;
            let pcont: u64 = 0;
            if c.dry || s0 >= mulsh(lamt, eR, 32) {
                let wr = q;
                let lthr = mulsh(lamt, eL, 32);
                let cut_r = s0 / 1000000000;
                let cut_p = s0 / 1000000000000;
                i = 0;
                while i < nR {
                    if wr < cut_r { break; }
                    let need = i64(G0) - i64(R[i]);
                    let j0: u64 = 0;
                    if need > 1 { if u64(need) > SL + 1 { j0 = nL; } else { j0 = u64(cntL[u64(need)]); } }
                    let wl = mq(q, pw[j0]);
                    let inner: u64 = 0;
                    let jx = j0;
                    let ri = u64(R[i]);
                    while jx < nL {
                        if mq(wr, wl) < cut_p { break; }
                        if imp[ri + u64(Lf[jx])] == 1 { inner = inner + wl; }
                        wl = mq(wl, omq);
                        jx = jx + 1;
                    }
                    inner = inner + pw[nL];
                    let contrib = mq(wr, inner);
                    sc = sc + contrib;
                    if inner >= lthr { vpol = vpol + contrib; pcont = pcont + wr; }
                    wr = mq(wr, omq);
                    i = i + 1;
                }
            }
            let cpol = eR + mulsh(pcont, eL, 62);         // expected tests under the policy, Q32
            c.sum_score = c.sum_score + q40(sc);
            c.t_score = c.t_score + (rt_now_ns() - t1);
            if c.dry {
                ps(o, "S\t"); pu(o, m); tab(o);
                psci(o, sc, 62, 6); tab(o); psci(o, s0, 62, 6); tab(o);
                psec(o, mulsh(cpol, tp, 32), 4); tab(o);
                pu(o, nR); tab(o); pu(o, nL); tab(o);
                psci(o, vpol, 62, 6); tab(o); pfix(o, pcont >> 2, 60, 4); tab(o); psci(o, q, 62, 6);
                pb(o, 10);
                k = k + 1;
                continue;
            }
            if vpol == 0 || vpol < mulsh(lamt, cpol, 32) { k = k + 1; continue; }
            if c.gpu != 0 {
                c.ntested = c.ntested + 1;
                grp_add(grp, m, lnN, q, Gc, eL, nR, nL, sc, scal0, vpol, mulsh(cpol, tp, 32), pw[nL],
                        &R[0..c.SL + 2], &Lf[0..c.SL + 2], &imp[0..2 * c.SL + 4]);
                if grp.n == grp.G { grp_run(c, grp, o); }
                k = k + 1;
                continue;
            }

            // ---- stage 2: next prime; stage 3: previous prime if still worth it
            let t2 = rt_now_ns();
            c.ntested = c.ntested + 1;
            __gmpz_mul_ui(c.N, c.K, m);
            let bnext: i64 = -1;
            let aprev: i64 = -1;
            let tr: u64 = 0;
            let tl: u64 = 0;
            i = 0;
            while i < nR {
                __gmpz_add_ui(c.T, c.N, u64(R[i]));
                tr = tr + 1;
                if __gmpz_probab_prime_p(c.T, 1) != 0 { bnext = i64(R[i]); break; }
                i = i + 1;
            }
            let scb: u64 = 0;
            let pcal: u64 = 0;
            let completed = false;
            if bnext >= 0 {
                let b = u64(bnext);
                let wl = q;
                let tiny = ONE / 100000000000000;
                let jq: u64 = 0;
                while jq < nL {
                    if wl < tiny { break; }
                    let gg = b + u64(Lf[jq]);
                    if imp[gg] == 1 { scb = scb + wl; }
                    if gg >= Gc { pcal = pcal + wl; }
                    wl = mq(wl, omq);
                    jq = jq + 1;
                }
                scb = scb + pw[nL];
                pcal = pcal + pw[nL];
                let tpn = tp;
                if c.prp_n > 40 { tpn = c.prp_t / c.prp_n; }
                if scb >= mulsh(muldiv(c.lam, tpn, 1000000000), eL, 32) {
                    jq = 0;
                    while jq < nL {
                        __gmpz_sub_ui(c.T, c.N, u64(Lf[jq]));
                        tl = tl + 1;
                        if __gmpz_probab_prime_p(c.T, 1) != 0 { aprev = i64(Lf[jq]); break; }
                        jq = jq + 1;
                    }
                    if aprev >= 0 { completed = true; }
                }
            }
            let dt = rt_now_ns() - t2;
            c.t_test = c.t_test + dt;
            c.prp_n = c.prp_n + tr + tl;
            c.prp_t = c.prp_t + dt;
            let gap: u64 = 0;
            let m4: u64 = 0;
            let rq: u64 = 0;
            let hitcal: u64 = 0;
            let hit: u64 = 0;
            if completed {
                gap = u64(aprev) + u64(bnext);
                m4 = merit_e4(gap, lnN);
                if gap <= c.recmax { rq = rec[gap]; }
                if gap >= Gc { hitcal = 1; }
                c.ncomplete = c.ncomplete + 1;
                c.value = c.value + q40(scb);
                c.sum_pcal = c.sum_pcal + q40(pcal);
                c.calhits = c.calhits + hitcal;
                if imp[gap] == 1 {
                    __gmpz_add_ui(c.T, c.N, u64(bnext));
                    let ok1 = __gmpz_probab_prime_p(c.T, 25);
                    __gmpz_sub_ui(c.T, c.N, u64(aprev));
                    let ok2 = __gmpz_probab_prime_p(c.T, 25);
                    if ok1 != 0 && ok2 != 0 { hit = 1; c.nhits = c.nhits + 1; }
                }
            }
            // T  m digits sc scb completed a b gap merit rec tr tl pcal hitcal hit dt scal0 q vpol cpol
            ps(o, "T\t"); pu(o, m); tab(o);
            pu(o, lnN / 9889527665 + 1); tab(o);
            psci(o, sc, 62, 4); tab(o); psci(o, scb, 62, 4); tab(o);
            if completed { pb(o, 49); } else { pb(o, 48); } tab(o);
            pi(o, aprev); tab(o); pi(o, bnext); tab(o); pu(o, gap); tab(o);
            pmerit(o, m4); tab(o); prec4(o, rq); tab(o);
            pu(o, tr); tab(o); pu(o, tl); tab(o);
            pfix(o, pcal >> 2, 60, 5); tab(o); pu(o, hitcal); tab(o); pu(o, hit); tab(o);
            psec(o, dt, 3); tab(o); psci(o, scal0, 62, 6); tab(o); psci(o, q, 62, 6); tab(o);
            psci(o, vpol, 62, 6); tab(o); psec(o, mulsh(cpol, tp, 32), 3);
            pb(o, 10);
            flush(o);
            k = k + 1;
        }
        b0 = b0 + mb;
    }
    if c.gpu != 0 { grp_run(c, grp, o); }
    rt_free(changing_ptr);
    let tt = rt_now_ns() - t0 + c.t_pre;
    // summary line (same keys as the C engine)
    ps(o, "#\tP="); pu(o, c.P); ps(o, "\td="); pu(o, c.d); ps(o, "\tm0="); pu(o, c.m0);
    ps(o, "\tM="); pu(o, c.M); ps(o, "\tSL="); pu(o, c.SL); ps(o, "\tL="); pu(o, c.L);
    ps(o, "\tlambda="); psci(o, c.lam >> 2, 60, 4);
    ps(o, "\tcand="); pu(o, c.ncand); ps(o, "\ttested="); pu(o, c.ntested); ps(o, "\tcompleted="); pu(o, c.ncomplete);
    ps(o, "\tsum_score="); psci(o, c.sum_score, 40, 6);
    ps(o, "\tvalue="); psci(o, c.value, 40, 6);
    ps(o, "\tpcal="); pfix(o, c.sum_pcal, 40, 4);
    ps(o, "\tcalhits="); pu(o, c.calhits); ps(o, "\thits="); pu(o, c.nhits);
    ps(o, "\tt_prp="); psec(o, c.tprp, 5);
    ps(o, "\tprp_mean="); if c.prp_n > 0 { psec(o, c.prp_t / c.prp_n, 5); } else { ps(o, "0.00000"); }
    ps(o, "\tpre_s="); psec(o, c.t_pre, 2); ps(o, "\tsieve_s="); psec(o, c.t_sieve, 2);
    ps(o, "\tscore_s="); psec(o, c.t_score, 2); ps(o, "\ttest_s="); psec(o, c.t_test, 2);
    ps(o, "\ttotal_s="); psec(o, tt, 2); ps(o, "\tcpu_s="); psec(o, rt_cpu_ns(), 2);
    ps(o, "\tengine=praetor"); if c.gpu == 1 { ps(o, "+metal"); } if c.gpu == 2 { ps(o, "+wavefront-ref"); }
    pb(o, 10);
    flush(o);
}

fn new_ctx() -> Ctx {
    let z: *void = rt_mpz();
    let c = Ctx {
        P: 0, d: 1, m0: 1, M: 1, SL: 1, L: 1, lam: 0, mcal: 0, dry: false,
        K: z, N: z, T: z, lnK: 0,
        pr: rt_alloc32(1), np: 0, lprod: 0, kr: rt_alloc32(1),
        rec: rt_alloc64(1), recmax: 0,
        bits: rt_alloc64(1), words: 1, MB: 1,
        R: rt_alloc32(1), Lf: rt_alloc32(1), cntL: rt_alloc32(1), pw: rt_alloc64(1), imp: rt_alloc8(1),
        tprp: 0, prp_n: 0, prp_t: 0,
        gpu: 0, nl: 0,
        ncand: 0, ntested: 0, ncomplete: 0, nhits: 0,
        sum_score: 0, value: 0, sum_pcal: 0, calhits: 0,
        t_pre: 0, t_sieve: 0, t_score: 0, t_test: 0
    };
    return c;
}


// ---------------------------------------------------------------- bench: cpu vs gpu prime tests
fn cmd_bench() -> i32 {
    let P = parse_num(arg_or(2, "4001"));
    let d = parse_num(arg_or(3, "210"));
    let count = parse_num(arg_or(4, "4096"));
    let o = out_new(1, 1 << 14);
    let K = rt_mpz(); let N = rt_mpz(); let T = rt_mpz(); let g = rt_mpz(); let sp = rt_mpz();
    __gmpz_primorial_ui(K, P);
    __gmpz_divexact_ui(K, K, d);
    let m: u64 = 1000003;
    while gcd64(m, d) != 1 { m = m + 2; }
    __gmpz_mul_ui(N, K, m);
    __gmpz_primorial_ui(sp, 3000);
    let nl = u64(rt_mpz_bits(N)) / 32 + 2;
    let digits = __gmpz_sizeinbase(N, 10);
    let offs = slice(rt_alloc64(count), count);
    let nums = slice(rt_alloc32(count * nl), count * nl);
    let rmods = slice(rt_alloc32(count * nl), count * nl);
    let res = slice(rt_alloc8(count), count);
    let ref = slice(rt_alloc8(count), count);
    let gmpr = slice(rt_alloc8(count), count);
    let got: u64 = 0;
    let off: u64 = 2;          // N is odd, so even offsets give odd candidates
    while got < count {
        __gmpz_add_ui(T, N, off);
        __gmpz_gcd(g, T, sp);
        if __gmpz_cmp_ui(g, 1) == 0 {
            offs[got] = off;
            rt_pack(T, &mut nums[got * nl], &mut rmods[got * nl], i32(nl));
            got = got + 1;
        }
        off = off + 2;
    }
    ps(o, "hunter bench -- P="); pu(o, P); ps(o, " d="); pu(o, d); ps(o, "  ("); pu(o, digits);
    ps(o, " digits, "); pu(o, nl); ps(o, " limbs), "); pu(o, count); ps(o, " survivor-like numbers\n");
    // cpu: gmp, single thread
    let ncpu = u64(rt_ncpu());
    let t0 = rt_now_ns();
    let nc = count;
    if nc > 256 { nc = 256; }       // gmp times (and labels) the first 256; the gpu runs the whole batch
    let i: u64 = 0;
    let primes: u64 = 0;
    let first_prime = count;
    while i < nc {
        __gmpz_add_ui(T, N, offs[i]);
        let r = __gmpz_probab_prime_p(T, 1);
        if r != 0 { gmpr[i] = 1; primes = primes + 1; if first_prime == count { first_prime = i; } } else { gmpr[i] = 0; }
        i = i + 1;
    }
    t0 = rt_now_ns() - t0;
    // the math check must include a prime: keep labelling until one shows up
    let known = nc;
    while first_prime == count && known < count {
        __gmpz_add_ui(T, N, offs[known]);
        if __gmpz_probab_prime_p(T, 1) != 0 { gmpr[known] = 1; primes = primes + 1; first_prime = known; } else { gmpr[known] = 0; }
        known = known + 1;
    }
    if first_prime < count && first_prime > 0 {
        // move it to slot 0 so the 16-number reference check sees it
        let w: u64 = 0;
        while w < nl {
            let a = nums[w]; nums[w] = nums[first_prime * nl + w]; nums[first_prime * nl + w] = a;
            let b = rmods[w]; rmods[w] = rmods[first_prime * nl + w]; rmods[first_prime * nl + w] = b;
            w = w + 1;
        }
        let o0 = offs[0]; offs[0] = offs[first_prime]; offs[first_prime] = o0;
        let g0 = gmpr[0]; gmpr[0] = gmpr[first_prime]; gmpr[first_prime] = g0;
    }
    let cpu_ns = t0 / nc;
    ps(o, "  cpu  (gmp, 1 core)      "); psec(o, cpu_ns * 1000, 3); ps(o, " ms/test  =  ");
    pu(o, 1000000000 / cpu_ns); ps(o, " tests/s per core, ~"); pu(o, ncpu * 1000000000 / cpu_ns);
    ps(o, " tests/s on all "); pu(o, ncpu); ps(o, " cores\n");
    flush(o);
    // reference montgomery (the exact algorithm the gpu runs), a slice of the batch
    let nr = count;
    if nr > 16 { nr = 16; }
    let t1 = rt_now_ns();
    rt_cpu_fermat_batch(&mut nums[0], &mut rmods[0], i32(nl), i32(nr), &mut ref[0]);
    let ref_ns = (rt_now_ns() - t1) / nr;
    let bad_ref: u64 = 0;
    i = 0;
    while i < nr { if ref[i] != gmpr[i] { bad_ref = bad_ref + 1; } i = i + 1; }
    ps(o, "  cpu  (montgomery ref)   "); psec(o, ref_ns * 1000, 3); ps(o, " ms/test  (math check vs gmp: ");
    pu(o, bad_ref); ps(o, " mismatches of "); pu(o, nr); ps(o, ")\n");
    flush(o);
    if rt_gpu_available() == 1 {
        let gn = rt_gpu_name();
        ps(o, "  gpu: ");
        let gs = slice(gn, rt_strlen(gn));
        pbs(o, gs, 0, gs.len);
        pb(o, 10);
        // first a small batch (compiles the pipeline, proves the kernel runs), then the real one.
        // both are time-boxed: the bench can never hang the machine
        let w = count;
        if w > 32 { w = 32; }
        ps(o, "  gpu  warm-up, "); pu(o, w); ps(o, " numbers ... ");
        flush(o);
        rt_gpu_set_budget_ms(60000);
        let tw = rt_now_ns();
        let uw = rt_gpu_fermat_batch(&mut nums[0], &mut rmods[0], i32(nl), i32(w), &mut res[0]);
        let ok = uw >= 0;
        if ok {
            psec(o, rt_now_ns() - tw, 2); ps(o, " s\n");
        } else {
            ps(o, "failed: "); let ge0 = rt_gpu_error(); pbs(o, slice(ge0, rt_strlen(ge0)), 0, rt_strlen(ge0)); pb(o, 10);
        }
        flush(o);
        if ok {
            ps(o, "  gpu  full batch, "); pu(o, count); ps(o, " numbers ... ");
            flush(o);
            rt_gpu_set_budget_ms(180000);
            let t2 = rt_now_ns();
            let used = rt_gpu_fermat_batch(&mut nums[0], &mut rmods[0], i32(nl), i32(count), &mut res[0]);
            let gpu_ns = (rt_now_ns() - t2) / count;
            if used < 0 {
                ps(o, "\n       "); let ge = rt_gpu_error(); pbs(o, slice(ge, rt_strlen(ge)), 0, rt_strlen(ge)); pb(o, 10);
            } else {
                let bad: u64 = 0;
                i = 0;
                while i < known { if res[i] != gmpr[i] { bad = bad + 1; } i = i + 1; }
                psec(o, gpu_ns * count, 2); ps(o, " s\n");
                ps(o, "  gpu  (32 lanes per number) "); psec(o, gpu_ns * 1000, 3); ps(o, " ms/test  =  ");
                pu(o, 1000000000 / (gpu_ns + 1)); ps(o, " tests/s   ("); pu(o, bad); ps(o, " mismatches vs gmp of ");
                pu(o, known); ps(o, ")\n");
                ps(o, "       = "); pfix(o, muldiv(1000000000 / (gpu_ns + 1), u64(1) << 20, ncpu * 1000000000 / cpu_ns), 20, 2);
                ps(o, "x all "); pu(o, ncpu); ps(o, " cpu cores\n");
            }
            flush(o);
        }
        rt_gpu_set_budget_ms(0);
    } else {
        let ge = rt_gpu_error();
        let gl = rt_strlen(ge);
        if gl > 0 {
            ps(o, "  gpu  not available: ");
            let gs2 = slice(ge, gl);
            pbs(o, gs2, 0, gl);
            ps(o, "\n  (the hunter still runs fine on the cpu cores; send this line to claude)\n");
        } else {
            ps(o, "  gpu  not available on this machine (metal is macos-only)\n");
        }
    }
    ps(o, "  primes among the gmp-labelled numbers: "); pu(o, primes); pb(o, 10);
    flush(o);
    return 0;
}

fn file_size_of(p: str) -> i64 { return rt_file_size(p.bytes.ptr); }

fn cmd_hunt() -> i32 {
    if process.argc() < 11 {
        io.eprintln("usage: hunter hunt P d m0 M SL L lambda mcal records.txt");
        return 1;
    }
    let c = new_ctx();
    c.P = parse_num(arg_or(2, "0"));
    c.d = parse_num(arg_or(3, "1"));
    c.m0 = parse_num(arg_or(4, "1"));
    c.M = parse_num(arg_or(5, "1"));
    c.SL = parse_num(arg_or(6, "1"));
    c.L = parse_num(arg_or(7, "1"));
    c.lam = parse_sci_q62(arg_or(8, "0"));
    let mc = arg_or(9, "0");
    c.mcal = parse_q32(mc.bytes, 0, mc.len);
    let gv = process.env("HUNTER_GPU");
    c.gpu = 0;
    match gv {
        Ok(v) => { if v == "ref" { c.gpu = 2; } else { if v == "1" { if rt_gpu_available() == 1 { c.gpu = 1; } } } }
        Err(e) => {}
    }
    let dr = process.env("HUNT_DRY");
    match dr {
        Ok(v) => { c.dry = true; }
        Err(e) => { c.dry = false; }
    }
    let rp = arg_or(10, "records.txt");
    let rs = file_size_of(rp);
    if rs < 1000000 {
        // with no table every gap would look like a record. refuse instead of lying.
        io.eprintln("hunter hunt: records.txt is missing or truncated -- refusing to hunt without the record table");
        return 2;
    }
    engine_setup(c, rp);
    if c.recmax < 100000 {
        io.eprintln("hunter hunt: the record table covers too few gap sizes -- refusing to hunt");
        return 2;
    }
    let o = out_new(1, 1 << 16);
    run_engine(c, o);
    return 0;
}


// ================================================================ hunter serve: the control room
//
// one program: the http dashboard, the learner, and the scheduler. every core runs `hunter hunt`
// as a child process (true parallelism + crash isolation); their output is parsed live here.
// everything durable is a plain file next to the binary:
//   state.tsv     learner state (raw fixed-point integers)
//   gaps.tsv      every tested center, one line each (same columns as the python v3 hunter)
//   FOUND.tsv     records, the moment they are found        VERIFIED.tsv  independent gmp checks
//   jobs.tsv      one line per finished job                  hunt.log      human-readable log
// the dashboard (ui.html) polls /api/status and pulls the raw files; it does its statistics in js.

