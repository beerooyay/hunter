// ---------------------------------------------------------------- byte-string helpers
fn bz(write o: Out) { o.len = 0; }
fn bcz(write o: Out, t: str) { o.len = 0; ps(o, t); pb(o, 0); }     // literal -> C string in o
fn bend(write o: Out) { pb(o, 0); o.len = o.len - 1; }               // NUL-terminate, keep length
fn pbs(write o: Out, s: slice u8, lo: u64, hi: u64) {
    let i = lo;
    while i < hi { pb(o, s[i]); i = i + 1; }
}
fn starts(s: slice u8, n: u64, at: u64, t: str) -> bool {
    if at + t.len > n { return false; }
    let i: u64 = 0;
    while i < t.len { if s[at + i] != t.bytes[i] { return false; } i = i + 1; }
    return true;
}
fn eqs(s: slice u8, lo: u64, hi: u64, t: str) -> bool {
    if hi - lo != t.len { return false; }
    return starts(s, hi, lo, t);
}
fn num_at(s: slice u8, lo: u64, hi: u64) -> u64 {
    let v: u64 = 0;
    let i = lo;
    while i < hi && isdig(s[i]) { v = v * 10 + u64(s[i] - 48); i = i + 1; }
    return v;
}

fn skip_digits(s: slice u8, at: u64) -> u64 {
    let i = at;
    while i < s.len && isdig(s[i]) { i = i + 1; }
    return i;
}

// tab-separated field k of s[0..n] -> [lo, hi)
struct Span { lo: u64, hi: u64 }
fn fld(s: slice u8, n: u64, k: u64) -> Span {
    let i: u64 = 0;
    let f: u64 = 0;
    while i < n && f < k { if s[i] == 9 { f = f + 1; } i = i + 1; }
    let lo = i;
    while i < n && s[i] != 9 && s[i] != 10 { i = i + 1; }
    if f < k { return Span { lo: n, hi: n }; }
    return Span { lo: lo, hi: i };
}
// value of "key=" in a tab- or &-separated line -> [lo, hi), lo == hi if missing
fn kv(s: slice u8, n: u64, key: str) -> Span {
    let i: u64 = 0;
    while i < n {
        if (i == 0 || s[i - 1] == 9 || s[i - 1] == 38) && starts(s, n, i, key) && i + key.len < n && s[i + key.len] == 61 {
            let lo = i + key.len + 1;
            let j = lo;
            while j < n && s[j] != 9 && s[j] != 38 && s[j] != 10 && s[j] != 13 { j = j + 1; }
            return Span { lo: lo, hi: j };
        }
        i = i + 1;
    }
    return Span { lo: 0, hi: 0 };
}

// ---------------------------------------------------------------- fixed-point learner math
// rates are expected records per core-hour in Q40; logs are natural logs in signed Q32.
fn LN2_32() -> i64 { return 2977044472; }
fn isqrt(x: u64) -> u64 {
    if x == 0 { return 0; }
    let r: u64 = 0;
    let bit: u64 = u64(1) << 62;
    let v = x;
    while bit > v { bit = bit >> 2; }
    while bit != 0 {
        if v >= r + bit { v = v - r - bit; r = (r >> 1) + bit; } else { r = r >> 1; }
        bit = bit >> 2;
    }
    return r;
}
fn sabs(x: i64) -> u64 { if x < 0 { return u64(0) - u64(x); } return u64(x); }
fn sgn(neg: bool, v: u64) -> i64 { if neg { return 0 - i64(v); } return i64(v); }
fn smul32(a: i64, b: u64) -> i64 { return sgn(a < 0, mulsh(sabs(a), b, 32)); }        // a * b, b in Q32
fn sdiv32(a: i64, b: u64) -> i64 { return sgn(a < 0, muldiv(sabs(a), u64(1) << 32, b)); } // a / b, b in Q32
fn ln_rate(r: u64) -> i64 {                       // ln(Q40 value) in Q32
    if r == 0 { return 0 - 296685830120; }        // ln(1e-30), like the python learner's clamp
    return i64(ln_q32(r)) - 40 * LN2_32();
}
fn exp_q(x: i64, f: u64) -> u64 {                 // e^x (x in Q32) as Q(f), saturating
    let y = smul32(x, 6196328019);                // x * log2(e)
    let k: i64 = 0;                               // floor(y / 2^32)
    if y >= 0 { k = y / 4294967296; } else { k = 0 - i64((sabs(y) + 4294967295) / 4294967296); }
    let fr = u64(y - k * 4294967296);             // [0, 2^32)
    let ln2: u64 = 3196577161300663914;
    let t = mulsh(fr, ln2, 32);                   // fr * ln2, Q62
    let sum: u64 = u64(1) << 62;
    let term: u64 = u64(1) << 62;
    let n: u64 = 1;
    while n < 24 { term = mq(term, t) / n; sum = sum + term; n = n + 1; }
    let sh: i64 = 62 - i64(f) - k;                // value = sum * 2^k / 2^62, wanted in Q(f)
    if sh >= 63 { return 0; }
    if sh <= 0 {
        if 0 - sh >= 1 { return u64(0) - 1; }
        return sum;
    }
    return sum >> u64(sh);
}
fn rng(write s: Srv) -> u64 {
    let x = s.rng;
    x = x ^ (x >> 12); x = x ^ (x << 25); x = x ^ (x >> 27);
    s.rng = x;
    return x * 2685821657736338717;
}

// ---------------------------------------------------------------- server state
// arm record (72 u64 fields):
//   0 P  1 d  2 lnK(Q32)  3 next_m  4 prior(Q40/core-h)  5 value(Q40)  6 cpu ns  7 jobs  8 tested
//   9 completed  10 hits  11 candidates  12 predicted-calibration(Q40)  13 calibration hits
//   14 ns per m  15 priced (0 no, 1 pricing, 2 yes)  16 in current set  17 n logs
//   18 gpu jobs  19 gpu wall ns  20 gpu value(Q40)  21 gpu tested  22 gpu hits  23 SL  24 digits
//   25..64 last 40 log-rates (i64 bits, ring); 65 bounded cold-start attempts
// worker slot (32 u64 fields):
//   0 pid  1 arm  2 m0  3 M  4 dry  5 gpu  6 started  7 tested  8 out fd  9 last gap  10 last merit(Q32)
//   11 last completed  12 dry value(Q50)  13 dry cost(Q32 s)  14 calibration prediction(Q40)
//   15 calibration hits  16 lambda used(Q40/core-h)  17 line length  18 summary length  19 completed
//   20 killed by us  21 consecutive failed jobs in this slot
struct Srv {
    A: *u64, na: u64,
    W: *u64, nw: u64,
    LN: *u8, SM: *u8,
    V: *u64,
    running: bool, stopping: bool, ends: u64, started: u64, cores: u64,
    gpu_ok: bool, gpu_on: bool, job_secs: u64, lam: u64, scale: u64, caff: i64, rng: u64,
    rec_pid: i64, rec_st: u64, bench_pid: i64, bench_st: u64,
    disc: *u8, dlen: u64, ncpu: u64, port: u64, found: u64,
}
fn AS() -> u64 { return 72; }
fn WS() -> u64 { return 32; }
fn MAXA() -> u64 { return 32; }
fn MAXW() -> u64 { return 64; }
fn LB() -> u64 { return 16384; }

fn av(write s: Srv, i: u64, f: u64) -> u64 { let a = slice(s.A, MAXA() * AS()); return a[i * AS() + f]; }
fn aset(write s: Srv, i: u64, f: u64, v: u64) { let a = slice(s.A, MAXA() * AS()); a[i * AS() + f] = v; }
fn aadd(write s: Srv, i: u64, f: u64, v: u64) { let a = slice(s.A, MAXA() * AS()); a[i * AS() + f] = a[i * AS() + f] + v; }
fn wv(write s: Srv, i: u64, f: u64) -> u64 { let w = slice(s.W, MAXW() * WS()); return w[i * WS() + f]; }
fn wset(write s: Srv, i: u64, f: u64, v: u64) { let w = slice(s.W, MAXW() * WS()); w[i * WS() + f] = v; }
fn wadd(write s: Srv, i: u64, f: u64, v: u64) { let w = slice(s.W, MAXW() * WS()); w[i * WS() + f] = w[i * WS() + f] + v; }

fn arm_key(write o: Out, write s: Srv, i: u64) { ps(o, "P"); pu(o, av(s, i, 0)); ps(o, "_d"); pu(o, av(s, i, 1)); ps(o, "_L1e9"); }

fn coprime_q32(d: u64) -> u64 {                   // prod over p | d of (1 - 1/p), Q32
    let f: u64 = u64(1) << 32;
    let n = d;
    let p: u64 = 2;
    while p * p <= n {
        if n % p == 0 { f = f - f / p; while n % p == 0 { n = n / p; } }
        p = p + 1;
    }
    if n > 1 { f = f - f / n; }
    return f;
}
fn is_prime_small(n: u64) -> bool {
    if n < 2 { return false; }
    let p: u64 = 2;
    while p * p <= n { if n % p == 0 { return false; } p = p + 1; }
    return true;
}
fn arm_find(write s: Srv, P: u64, d: u64) -> u64 {
    let i: u64 = 0;
    while i < s.na { if av(s, i, 0) == P && av(s, i, 1) == d { return i; } i = i + 1; }
    return MAXA();
}
// add arm (P, d) if valid: d squarefree with every prime factor <= P. returns index or MAXA
fn arm_add(write s: Srv, P: u64, d: u64) -> u64 {
    let have = arm_find(s, P, d);
    if have < MAXA() { return have; }
    if s.na >= MAXA() || P < 11 || P > 200000 || d < 1 { return MAXA(); }
    let n = d;
    let p: u64 = 2;
    while p * p <= n {
        if n % p == 0 { n = n / p; if n % p == 0 { return MAXA(); } if p > P { return MAXA(); } }
        p = p + 1;
    }
    if n > P { return MAXA(); }
    let i = s.na;
    s.na = s.na + 1;
    let a = slice(s.A, MAXA() * AS());
    let k: u64 = 0;
    while k < AS() { a[i * AS() + k] = 0; k = k + 1; }
    let lnk: u64 = 0;
    let q: u64 = 2;
    while q <= P { if is_prime_small(q) { lnk = lnk + ln_q32(q); } q = q + 1; }
    lnk = lnk - ln_q32(d);
    a[i * AS() + 0] = P;
    a[i * AS() + 1] = d;
    a[i * AS() + 2] = lnk;
    a[i * AS() + 3] = (2000000 + rng(s) % 18000000) | 1;
    a[i * AS() + 23] = (25 * lnk) >> 32;
    a[i * AS() + 24] = (lnk + 66249649223) / 9889527671;
    return i;
}

// ---------------------------------------------------------------- the learner (port of brain.py v3.1)
fn actual_rate(write s: Srv, i: u64) -> u64 {    // achieved records per core-hour, Q40
    let ns = av(s, i, 6);
    if ns == 0 { return 0; }
    return muldiv(av(s, i, 5), 3600000000000, ns);
}
// dry-run prices ignore process overhead, so they run high by a ~constant factor: measure it (Q32)
fn price_scale(write s: Srv) -> u64 {
    let r: [32]u64;
    r[0] = 0;
    let n: u64 = 0;
    let i: u64 = 0;
    while i < s.na {
        if av(s, i, 15) == 2 && av(s, i, 4) > 0 && av(s, i, 6) > 600000000000 && av(s, i, 5) > 0 {
            let ar_ = actual_rate(s, i);
            let pr_ = av(s, i, 4);
            r[n] = muldiv(ar_, u64(1) << 32, pr_);
            n = n + 1;
        }
        i = i + 1;
    }
    if n == 0 { return u64(1) << 31; }
    let a: u64 = 1;                                  // insertion sort, then the median
    while a < n {
        let v = r[a];
        let b = a;
        while b > 0 && r[b - 1] > v { r[b] = r[b - 1]; b = b - 1; }
        r[b] = v;
        a = a + 1;
    }
    return r[n / 2];
}
struct Post { mu: i64, v: u64 }
// Log-normal posterior on modeled yield per CPU-hour, not measured record frequency.
// Aggregate survivor calibration does not establish extreme-tail calibration.
fn posterior(write s: Srv, i: u64, scale: u64) -> Post {
    let mu0: i64 = 0 - 24167014037;                  // ln(3.6e-3 per core-hour)
    let var0: u64 = u64(16) << 32;
    if av(s, i, 15) == 2 && av(s, i, 4) > 0 {
        mu0 = ln_rate(mulsh(av(s, i, 4), scale, 32));
        var0 = 1546188227;                           // 0.6^2
    }
    let nl = av(s, i, 17);
    let n = nl;
    if n > 40 { n = 40; }
    if n == 0 { return Post { mu: mu0, v: var0 }; }
    let a = slice(s.A, MAXA() * AS());
    let sum: i64 = 0;
    let k: u64 = 0;
    while k < n { sum = sum + i64(a[i * AS() + 25 + k]); k = k + 1; }
    let m: i64 = sum / i64(n);
    let v: u64 = 2147483648;                         // 0.5 when n == 1
    if n > 1 {
        let ss: u64 = 0;
        k = 0;
        while k < n { let dlt = sabs(i64(a[i * AS() + 25 + k]) - m); ss = ss + mulsh(dlt, dlt, 32); k = k + 1; }
        v = ss / (n - 1);
        if v < 644245094 { v = 644245094; }          // floor 0.15
    }
    let inv0 = muldiv(u64(1) << 32, u64(1) << 32, var0);
    let nv = muldiv(n << 32, u64(1) << 32, v);
    let pv = muldiv(u64(1) << 32, u64(1) << 32, inv0 + nv);
    let t = sdiv32(mu0, var0) + sgn(m < 0, muldiv(n * sabs(m), u64(1) << 32, v));
    return Post { mu: smul32(t, pv), v: pv };
}
fn est_rate(write s: Srv, i: u64, scale: u64) -> u64 {
    let p = posterior(s, i, scale);
    return exp_q(p.mu + i64(p.v / 2), 40);
}
fn draw(write s: Srv, i: u64, scale: u64) -> i64 {      // thompson sample of ln(rate)
    let p = posterior(s, i, scale);
    let z: i64 = 0;
    let k: u64 = 0;
    while k < 12 { z = z + i64(rng(s) >> 32); k = k + 1; }
    z = z - (i64(6) << 32);                               // irwin-hall: ~ N(0, 1), Q32
    let sd = isqrt(p.v) << 16;
    return p.mu + smul32(z, sd);
}
// the stopping-rule bar: 0.8 x the best trusted achieved rate among the arms being hunted; before any
// has a real core-hour, half the scaled best dry-run price (v3.0 left it at 0: skip silently off)
fn compute_lambda(write s: Srv) {
    let sc = price_scale(s);
    s.scale = sc;
    let best: u64 = 0;
    let i: u64 = 0;
    while i < s.na {
        if av(s, i, 16) == 1 && av(s, i, 6) >= 1200000000000 && av(s, i, 7) >= 2 {
            let r = actual_rate(s, i);
            let e = est_rate(s, i, sc);
            if e < r { r = e; }
            if r > best { best = r; }
        }
        i = i + 1;
    }
    if best > 0 { s.lam = mulsh(best, 3435973837, 32); return; }   // 0.8
    let bp: u64 = 0;
    i = 0;
    while i < s.na { if av(s, i, 16) == 1 && av(s, i, 15) == 2 && av(s, i, 4) > bp { bp = av(s, i, 4); } i = i + 1; }
    s.lam = mulsh(bp, sc, 33);                                        // 0.5 * scale * best price
}
// pick the next arm: price every arm with a dry run first, then thompson sampling
fn choose(write s: Srv, allow_dry: bool) -> u64 {
    let i: u64 = 0;
    if allow_dry {
        while i < s.na {
            if av(s, i, 16) == 1 && av(s, i, 15) == 0 { aset(s, i, 15, 1); return i + 1000; }
            i = i + 1;
        }
    }
    // An arm with no tested centers needs a bounded, unfiltered first sample.
    // Do not launch duplicate cold-start jobs while one is already in flight.
    if allow_dry {
        i = 0;
        while i < s.na {
            if av(s, i, 16) == 1 && av(s, i, 15) == 2 && av(s, i, 8) == 0 && av(s, i, 65) < 2 {
                let occupied = false;
                let w: u64 = 0;
                while w < MAXW() {
                    if wv(s, w, 0) != 0 && wv(s, w, 1) == i { occupied = true; }
                    w = w + 1;
                }
                if !occupied { return i; }
            }
            i = i + 1;
        }
    }
    let sc = price_scale(s);
    let best: u64 = MAXA();
    let bd: i64 = 0;
    i = 0;
    while i < s.na {
        if av(s, i, 16) == 1 && (!allow_dry || av(s, i, 8) > 0 || av(s, i, 65) >= 2) {
            let occupied = false;
            if allow_dry && av(s, i, 8) == 0 {
                let w: u64 = 0;
                while w < MAXW() {
                    if wv(s, w, 0) != 0 && wv(s, w, 1) == i { occupied = true; }
                    w = w + 1;
                }
            }
            if !occupied {
            let d = draw(s, i, sc);
            if best == MAXA() || d > bd { best = i; bd = d; }
            }
        }
        i = i + 1;
    }
    return best;
}

// ---------------------------------------------------------------- files
fn log_out(write t: Out) {                       // t holds a message: timestamp it into hunt.log
    let dt: [32]u8;
    dt[0] = 0;
    let n = rt_date(&mut dt[0]);
    let o = out_new(0 - 1, t.len + 64);
    pb(o, 91); pbs(o, &dt[0..32], 0, n); ps(o, "] ");
    pbs(o, slice(t.p, t.cap), 0, t.len); pb(o, 10);
    rt_append("hunt.log", o.p, o.len);
    rt_free(o.p);
}
fn log_line(write b: Out, t: str) { bz(b); ps(b, t); log_out(b); }
fn save_state(write s: Srv, write b: Out) {
    bz(b);
    ps(b, "# hunter state v1 -- raw fixed-point integers (arm field legend: struct Srv in src/hunter.lang)\n");
    let i: u64 = 0;
    while i < s.na {
        arm_key(b, s, i);
        let k: u64 = 0;
        while k < AS() { tab(b); if k >= 25 { pi(b, i64(av(s, i, k))); } else { pu(b, av(s, i, k)); } k = k + 1; }
        pb(b, 10);
        i = i + 1;
    }
    rt_write_atomic("state.tsv", b.p, b.len);
}
fn load_state(write s: Srv) {
    let n = rt_file_size("state.tsv");
    if n <= 0 { return; }
    let buf = rt_alloc8(u64(n) + 1);
    let got = rt_read_at("state.tsv", 0, buf, u64(n));
    if got <= 0 { rt_free(buf); return; }
    let t = slice(buf, u64(n) + 1);
    let N = u64(got);
    let i: u64 = 0;
    while i < N {
        let e = i;
        while e < N && t[e] != 10 { e = e + 1; }
        if t[i] == 80 {                                 // 'P'
            let line = &t[i..e];
            let L = e - i;
            let f1 = fld(line, L, 1);
            let f2 = fld(line, L, 2);
            let P = num_at(line, f1.lo, f1.hi);
            let d = num_at(line, f2.lo, f2.hi);
            let a = arm_add(s, P, d);
            if a < MAXA() {
                let k: u64 = 3;
                while k < AS() {
                    let f = fld(line, L, k + 1);
                    if f.lo < f.hi {
                        if line[f.lo] == 45 { aset(s, a, k, u64(0) - num_at(line, f.lo + 1, f.hi)); }
                        else { aset(s, a, k, num_at(line, f.lo, f.hi)); }
                    }
                    k = k + 1;
                }
                if av(s, a, 15) == 1 { aset(s, a, 15, 0); }  // a pricing run that never finished
                aset(s, a, 16, 0);
                // Migrate only empty histories; retain counters and multiplier reservations.
                if av(s, a, 8) == 0 && av(s, a, 5) == 0 { aset(s, a, 17, 0); }
            }
        }
        i = e + 1;
    }
    rt_free(buf);
}

// ---------------------------------------------------------------- workers
fn wpath(write o: Out, i: u64) { bz(o); ps(o, "run/w"); pu(o, i); ps(o, ".out"); bend(o); }

fn spawn_verify(write s: Srv, write b: Out, expr: slice u8, lo: u64, hi: u64, gap: u64) {
    bz(b);
    ps(b, "hunter"); pb(b, 0); ps(b, "verify"); pb(b, 0); pbs(b, expr, lo, hi); pb(b, 0); pu(b, gap); pb(b, 0);
    let v = slice(s.V, 16);
    let k: u64 = 0;
    while k < 16 {
        if v[k] == 0 {
            let pid = rt_spawn(b.p, 4, 1, "", 0, "run/verify.out");
            if pid > 0 { v[k] = u64(pid); }
            return;
        }
        k = k + 1;
    }
    // all 16 busy: it stays unverified until the next 'verify all'
}

fn on_line(write s: Srv, i: u64, ln: slice u8, n: u64, write b: Out, write t: Out) {
    if n < 2 { return; }
    let ar = wv(s, i, 1);
    if ln[0] == 83 {                                  // S: a dry-run center (sieve + score only)
        let cp = fld(ln, n, 4);
        let vp = fld(ln, n, 7);
        let cpol = parse_q32(ln, cp.lo, cp.hi);
        let vpol = parse_sci_s(ln, vp.lo, vp.hi);
        let lam_s = muldiv(wv(s, i, 16), u64(1) << 22, 3600);
        if vpol > 0 && vpol >= mulsh(lam_s, cpol, 32) { wadd(s, i, 12, vpol >> 12); wadd(s, i, 13, cpol); }
        return;
    }
    if ln[0] == 35 {                                  // #: job summary
        let sm = slice(s.SM, MAXW() * 2048);
        let k: u64 = 0;
        while k < n && k < 2047 { sm[i * 2048 + k] = ln[k]; k = k + 1; }
        wset(s, i, 18, k);
        return;
    }
    if ln[0] != 84 { return; }                        // T: a tested center
    bz(b);
    arm_key(b, s, ar);
    pbs(b, ln, 1, n);
    pb(b, 10);
    rt_append("gaps.tsv", b.p, b.len);
    let fm = fld(ln, n, 1);
    let fdone = fld(ln, n, 5);
    let fa = fld(ln, n, 6);
    let fg = fld(ln, n, 8);
    let fmer = fld(ln, n, 9);
    let frec = fld(ln, n, 10);
    let fhit = fld(ln, n, 15);
    let fsc = fld(ln, n, 17);
    let done = fdone.lo < fdone.hi && ln[fdone.lo] == 49;
    let gap = num_at(ln, fg.lo, fg.hi);
    let merit = parse_q32(ln, fmer.lo, fmer.hi);
    wadd(s, i, 7, 1);
    wset(s, i, 9, gap);
    wset(s, i, 10, merit);
    if done { wset(s, i, 11, 1); wadd(s, i, 19, 1); } else { wset(s, i, 11, 0); }
    wadd(s, i, 14, parse_sci_s(ln, fsc.lo, fsc.hi) >> 22);
    if done && merit >= (u64(15) << 32) { wadd(s, i, 15, 1); }
    if fhit.lo < fhit.hi && ln[fhit.lo] == 49 {
        // a record. FOUND.tsv first (it is what matters), then the log, then an independent check
        bz(b);
        pbs(b, ln, fg.lo, fg.hi); tab(b); pbs(b, ln, fmer.lo, fmer.hi); tab(b);
        let e0 = b.len;
        pbs(b, ln, fm.lo, fm.hi); pb(b, 42); pu(b, av(s, ar, 0)); ps(b, "#/"); pu(b, av(s, ar, 1)); pb(b, 45); pbs(b, ln, fa.lo, fa.hi);
        let e1 = b.len;
        ps(b, "\tprevious_record_merit="); pbs(b, ln, frec.lo, frec.hi); tab(b);
        let dt: [32]u8;
        dt[0] = 0;
        let dn = rt_date(&mut dt[0]);
        pbs(b, &dt[0..32], 0, dn); pb(b, 10);
        rt_append("FOUND.tsv", b.p, b.len);
        s.found = s.found + 1;
        let bb = slice(b.p, b.cap);
        let expr = rt_alloc8(e1 - e0 + 1);
        let ex = slice(expr, e1 - e0 + 1);
        let q: u64 = 0;
        while q < e1 - e0 { ex[q] = bb[e0 + q]; q = q + 1; }
        bz(t);
        ps(t, "*** RECORD  gap "); pbs(t, ln, fg.lo, fg.hi); ps(t, "  merit "); pbs(t, ln, fmer.lo, fmer.hi);
        ps(t, "  (old "); pbs(t, ln, frec.lo, frec.hi); ps(t, ")  "); pbs(t, ex, 0, e1 - e0); ps(t, "  -> FOUND.tsv, verifying");
        log_out(t);
        spawn_verify(s, b, ex, 0, e1 - e0, gap);
        rt_free(expr);
    }
}

// read whatever the worker has written since last time; hand complete lines to on_line
fn pump(write s: Srv, i: u64, write b: Out, write t: Out, write rd: Out) {
    let fd = wv(s, i, 8);
    if fd == 0 { return; }
    let lb = slice(s.LN, MAXW() * LB());
    let base = i * LB();
    while true {
        let r = rt_read_fd(i64(fd - 1), rd.p, rd.cap);
        if r <= 0 { return; }
        let src = slice(rd.p, rd.cap);
        let k: u64 = 0;
        while k < u64(r) {
            let c = src[k];
            let L = wv(s, i, 17);
            if c == 10 {
                on_line(s, i, &lb[base..base + LB()], L, b, t);
                wset(s, i, 17, 0);
            } else {
                if L + 1 < LB() { lb[base + L] = c; wset(s, i, 17, L + 1); }
            }
            k = k + 1;
        }
    }
}

fn finish(write s: Srv, i: u64, st: i32, write b: Out, write t: Out) {
    let ar = wv(s, i, 1);
    rt_close_fd(i64(wv(s, i, 8) - 1));
    wset(s, i, 0, 0);
    wset(s, i, 8, 0);
    let sm = slice(s.SM, MAXW() * 2048);
    let n = wv(s, i, 18);
    let line = &sm[i * 2048..i * 2048 + 2048];
    let dry = wv(s, i, 4) == 1;
    let gpu = wv(s, i, 5) == 1;
    let M = wv(s, i, 3);
    if n == 0 {
        if dry { aset(s, ar, 15, 0); }
        bz(t);
        ps(t, "core "); pu(t, i); ps(t, " job ended without a summary (exit "); pi(t, i64(st));
        if wv(s, i, 20) == 1 { ps(t, ", stopped by you)"); } else {
            ps(t, ") -- its output is in run/w"); pu(t, i); ps(t, ".out");
            wadd(s, i, 21, 1);
        }
        log_out(t);
        if wv(s, i, 21) >= 3 && s.running && !s.stopping {
            // a crash loop helps nobody: pause and say why instead of respawning forever
            s.stopping = true;
            log_line(b, "workers keep failing, so the hunt is pausing. check run/w*.out, then start again");
        }
        return;
    }
    wset(s, i, 21, 0);
    let fs_ = kv(line, n, "sieve_s");
    let fc = kv(line, n, "score_s");
    let fv = kv(line, n, "value");
    let fcpu = kv(line, n, "cpu_s");
    let ftot = kv(line, n, "total_s");
    let ft = kv(line, n, "tested");
    let fco = kv(line, n, "completed");
    let fh = kv(line, n, "hits");
    let fca = kv(line, n, "cand");
    let fpre = kv(line, n, "pre_s");
    let total_ns = muldiv(parse_q32(line, ftot.lo, ftot.hi), 1000000000, u64(1) << 32);
    bz(b);
    pu(b, rt_unix_s()); tab(b);
    bz(t);
    if dry {
        let over = parse_q32(line, fs_.lo, fs_.hi) + parse_q32(line, fc.lo, fc.hi);
        let den = over + wv(s, i, 13);
        let price: u64 = 0;
        if den > 0 { price = muldiv(wv(s, i, 12) >> 10, u64(3600) << 32, den); }
        aset(s, ar, 4, price);
        aset(s, ar, 15, 2);
        ps(b, "dry\t"); arm_key(b, s, ar); tab(b); pu(b, M); tab(b); psci(b, wv(s, i, 16), 40, 4); tab(b);
        psci(b, price, 40, 4); tab(b); pbs(b, line, fca.lo, fca.hi); pb(b, 10);
        ps(t, "core "); pu(t, i); ps(t, "  priced "); arm_key(t, s, ar); ps(t, "  model rate ");
        psci(t, price, 40, 2); ps(t, " records/core-h");
    } else {
        let value = parse_sci_s(line, fv.lo, fv.hi) >> 22;
        let cpu_ns = muldiv(parse_q32(line, fcpu.lo, fcpu.hi), 1000000000, u64(1) << 32);
        let tested = num_at(line, ft.lo, ft.hi);
        let hits = num_at(line, fh.lo, fh.hi);
        let rate: u64 = 0;
        if gpu {
            aadd(s, ar, 18, 1); aadd(s, ar, 19, total_ns); aadd(s, ar, 20, value);
            aadd(s, ar, 21, tested); aadd(s, ar, 22, hits);
            if total_ns > 0 { rate = muldiv(value, 3600000000000, total_ns); }
        } else {
            if cpu_ns > 0 { rate = muldiv(value, 3600000000000, cpu_ns); }
            aadd(s, ar, 5, value); aadd(s, ar, 6, cpu_ns); aadd(s, ar, 7, 1);
            let a = slice(s.A, MAXA() * AS());
            let nl = av(s, ar, 17);
            a[ar * AS() + 25 + (nl % 40)] = u64(ln_rate(rate));
            aset(s, ar, 17, nl + 1);
            let cp_ = wv(s, i, 14);
            let ch_ = wv(s, i, 15);
            aadd(s, ar, 12, cp_); aadd(s, ar, 13, ch_);
            aadd(s, ar, 8, tested); aadd(s, ar, 9, num_at(line, fco.lo, fco.hi));
            aadd(s, ar, 10, hits); aadd(s, ar, 11, num_at(line, fca.lo, fca.hi));
            if M > 0 { aset(s, ar, 14, total_ns / M); }
        }
        if gpu { ps(b, "gpu\t"); } else { ps(b, "job\t"); }
        arm_key(b, s, ar); tab(b); pu(b, M); tab(b); psci(b, wv(s, i, 16), 40, 4); tab(b);
        psci(b, rate, 40, 4); tab(b); psci(b, value, 40, 4); tab(b);
        pbs(b, line, fcpu.lo, fcpu.hi); tab(b); pbs(b, line, ftot.lo, ftot.hi); tab(b);
        pbs(b, line, ft.lo, ft.hi); tab(b); pbs(b, line, fca.lo, fca.hi); tab(b);
        pbs(b, line, fco.lo, fco.hi); tab(b); pbs(b, line, fh.lo, fh.hi); tab(b);
        psci(b, wv(s, i, 14), 40, 4); tab(b); pu(b, wv(s, i, 15)); tab(b);
        pbs(b, line, fpre.lo, fpre.hi); pb(b, 10);
        ps(t, "core "); pu(t, i); if gpu { ps(t, " (gpu)"); } ps(t, "  "); arm_key(t, s, ar);
        ps(t, "  tested "); pbs(t, line, ft.lo, ft.hi); pb(t, 47); pbs(t, line, fca.lo, fca.hi);
        ps(t, "  rate "); psci(t, rate, 40, 2); ps(t, "/core-h");
        if hits > 0 { ps(t, "  *** "); pu(t, hits); ps(t, " RECORD(S)"); }
    }
    rt_append("jobs.tsv", b.p, b.len);
    log_out(t);
    save_state(s, b);
}

fn start_job(write s: Srv, i: u64, write b: Out, write t: Out) {
    let isgpu = s.gpu_on && i == s.nw - 1;
    let c = choose(s, !isgpu);
    if c == MAXA() { return; }
    let dry = c >= 1000;
    let ar = c;
    if dry { ar = c - 1000; }
    compute_lambda(s);
    let P = av(s, ar, 0);
    let d = av(s, ar, 1);
    let cf = coprime_q32(d);
    let M: u64 = 0;
    if dry {
        M = muldiv(300, u64(1) << 32, cf);
        if M < 50 { M = 50; }
    } else {
        let spm = av(s, ar, 14);
        if spm == 0 {
            // 4.6 s * coprime(d) * (P/4001)^2.6, measured on the m4 max
            let lr = i64(ln_q32(P)) - i64(ln_q32(4001));
            let grow = exp_q(smul32(lr, 11166914970), 32);
            spm = muldiv(mulsh(19756849562, cf, 32), mulsh(grow, 1000000000, 32), u64(1) << 32);
            if spm == 0 { spm = 1; }
        }
        M = s.job_secs * 1000000000 / spm;
        if M < 20 { M = 20; }
    }
    let m0 = av(s, ar, 3);
    let job_lam = s.lam;
    let cold = !dry && !isgpu && av(s, ar, 8) == 0 && av(s, ar, 65) < 2;
    if cold { M = 20; job_lam = 0; }
    aset(s, ar, 3, m0 + M + (M & 1));
    bz(b);
    ps(b, "hunter"); pb(b, 0); ps(b, "hunt"); pb(b, 0);
    pu(b, P); pb(b, 0); pu(b, d); pb(b, 0); pu(b, m0); pb(b, 0); pu(b, M); pb(b, 0);
    pu(b, av(s, ar, 23)); pb(b, 0); ps(b, "1e9"); pb(b, 0);
    psci(b, muldiv(job_lam, u64(1) << 22, 3600), 62, 6); pb(b, 0);
    ps(b, "15"); pb(b, 0); ps(b, "records.txt"); pb(b, 0);
    bz(t);
    if dry { ps(t, "HUNT_DRY=1"); pb(t, 0); }
    if isgpu { ps(t, "HUNTER_GPU=1"); pb(t, 0); }
    let nenv: i32 = 0;
    if dry { nenv = nenv + 1; }
    if isgpu { nenv = nenv + 1; }
    rt_mkdir("run");
    let path = out_new(0 - 1, 64);
    wpath(path, i);
    rt_append(path.p, "", 0);
    let fd = rt_open_r(path.p);
    let pid = rt_spawn(b.p, 11, 1, t.p, nenv, path.p);
    rt_free(path.p);
    if pid <= 0 {
        if fd >= 0 { rt_close_fd(fd); }
        if dry { aset(s, ar, 15, 0); }
        log_line(b, "could not start a worker process");
        return;
    }
    let fails = wv(s, i, 21);
    if cold { aadd(s, ar, 65, 1); }
    let k: u64 = 0;
    while k < WS() { wset(s, i, k, 0); k = k + 1; }
    wset(s, i, 21, fails);
    wset(s, i, 0, u64(pid)); wset(s, i, 1, ar); wset(s, i, 2, m0); wset(s, i, 3, M);
    if dry { wset(s, i, 4, 1); }
    if isgpu { wset(s, i, 5, 1); }
    wset(s, i, 6, rt_unix_s());
    wset(s, i, 8, u64(fd + 1));
    let lam_now = job_lam;
    wset(s, i, 16, lam_now);
    // Persist reservations and cold-start attempts promptly, including across restarts.
    save_state(s, t);
}

fn busy(write s: Srv) -> u64 {
    let n: u64 = 0;
    let i: u64 = 0;
    while i < MAXW() { if wv(s, i, 0) != 0 { n = n + 1; } i = i + 1; }
    return n;
}

// ---------------------------------------------------------------- the live record table
// download the official table; it doubles as records.txt (gap merit who ...) and as the
// "is my record still on top" check for everything in FOUND.tsv
fn start_records(write s: Srv, write b: Out) {
    if s.rec_pid > 0 { return; }
    bz(b);
    ps(b, "curl"); pb(b, 0); ps(b, "-sfL"); pb(b, 0); ps(b, "--max-time"); pb(b, 0); ps(b, "240"); pb(b, 0);
    ps(b, "-o"); pb(b, 0); ps(b, "merits.tmp"); pb(b, 0);
    ps(b, "https://primegaps.cloudygo.com/merits.txt"); pb(b, 0);
    s.rec_pid = rt_spawn(b.p, 7, 0, "", 0, "run/curl.out");
    if s.rec_pid > 0 { s.rec_st = 1; } else { s.rec_st = 3; }
}
fn records_done(write s: Srv, code: i32, write b: Out) {
    s.rec_pid = 0;
    let sz = rt_file_size("merits.tmp");
    if code != 0 || sz < 1000000 { s.rec_st = 3; log_line(b, "record table download failed (kept the old records.txt)"); return; }
    rt_rename("records.txt", "records.bak");
    rt_rename("merits.tmp", "records.txt");
    // the gaps we hold, from FOUND.tsv
    let want: [512]u64;
    want[0] = 0;
    let nw: u64 = 0;
    let fsz = rt_file_size("FOUND.tsv");
    if fsz > 0 {
        let fb = rt_alloc8(u64(fsz) + 1);
        let got = rt_read_at("FOUND.tsv", 0, fb, u64(fsz));
        let f = slice(fb, u64(fsz) + 1);
        let i: u64 = 0;
        while i < u64(got) && nw < 512 {
            if isdig(f[i]) { want[nw] = num_at(f, i, u64(got)); nw = nw + 1; }
            while i < u64(got) && f[i] != 10 { i = i + 1; }
            i = i + 1;
        }
        rt_free(fb);
    }
    let rb = rt_alloc8(u64(sz) + 1);
    let got = rt_read_at("records.txt", 0, rb, u64(sz));
    let r = slice(rb, u64(sz) + 1);
    bz(b);
    ps(b, "# checked "); pu(b, rt_unix_s()); pb(b, 10);
    let i: u64 = 0;
    let lines: u64 = 0;
    while i < u64(got) {
        let e = i;
        while e < u64(got) && r[e] != 10 { e = e + 1; }
        if isdig(r[i]) {
            lines = lines + 1;
            let g = num_at(r, i, e);
            let k: u64 = 0;
            while k < nw {
                if want[k] == g {
                    // gap, merit, who: the first three whitespace-separated fields
                    let j = i;
                    let fcount: u64 = 0;
                    while j < e && fcount < 3 {
                        while j < e && r[j] != 32 && r[j] != 9 { pb(b, r[j]); j = j + 1; }
                        fcount = fcount + 1;
                        while j < e && (r[j] == 32 || r[j] == 9) { j = j + 1; }
                        if fcount < 3 { tab(b); }
                    }
                    pb(b, 10);
                    k = nw;
                }
                k = k + 1;
            }
        }
        i = e + 1;
    }
    rt_free(rb);
    rt_write_atomic("table.tsv", b.p, b.len);
    s.rec_st = 2;
    bz(b);
    ps(b, "records.txt refreshed from the live table (");
    pu(b, lines);
    ps(b, " gap sizes), checked ");
    pu(b, nw);
    ps(b, " of ours");
    log_out(b);
}

fn verify_pending(write s: Srv, write b: Out) -> u64 {
    // every FOUND expr that has no OK/FAILED line in VERIFIED.tsv
    let fsz = rt_file_size("FOUND.tsv");
    if fsz <= 0 { return 0; }
    let vsz = rt_file_size("VERIFIED.tsv");
    let fb = rt_alloc8(u64(fsz) + 1);
    let fg = rt_read_at("FOUND.tsv", 0, fb, u64(fsz));
    let f = slice(fb, u64(fsz) + 1);
    let vn: u64 = 0;
    if vsz > 0 { vn = u64(vsz); }
    let vb = rt_alloc8(vn + 1);
    let vg: i64 = 0;
    if vn > 0 { vg = rt_read_at("VERIFIED.tsv", 0, vb, vn); }
    let v = slice(vb, vn + 1);
    let started: u64 = 0;
    let i: u64 = 0;
    while i < u64(fg) {
        let e = i;
        while e < u64(fg) && f[e] != 10 { e = e + 1; }
        if isdig(f[i]) {
            let line = &f[i..e];
            let L = e - i;
            let fe = fld(line, L, 2);
            let gap = num_at(line, 0, L);
            // look for "\t<expr>\tOK" or FAILED in VERIFIED.tsv
            let seen = false;
            let j: u64 = 0;
            while j < u64(vg) && !seen {
                let ve = j;
                while ve < u64(vg) && v[ve] != 10 { ve = ve + 1; }
                let vl = &v[j..ve];
                let x = fld(vl, ve - j, 2);
                let st = fld(vl, ve - j, 3);
                if x.hi - x.lo == fe.hi - fe.lo && x.hi > x.lo {
                    let same = true;
                    let q: u64 = 0;
                    while q < x.hi - x.lo { if vl[x.lo + q] != line[fe.lo + q] { same = false; } q = q + 1; }
                    if same && (eqs(vl, st.lo, st.hi, "OK") || eqs(vl, st.lo, st.hi, "FAILED")) { seen = true; }
                }
                j = ve + 1;
            }
            if !seen && fe.hi > fe.lo { spawn_verify(s, b, line, fe.lo, fe.hi, gap); started = started + 1; }
        }
        i = e + 1;
    }
    rt_free(fb);
    rt_free(vb);
    return started;
}

// ---------------------------------------------------------------- one scheduler tick
fn tick(write s: Srv, write b: Out, write t: Out, write rd: Out) {
    let i: u64 = 0;
    while i < MAXW() {
        let pid = wv(s, i, 0);
        if pid != 0 {
            pump(s, i, b, t, rd);
            let st = rt_reap(i64(pid));
            if st >= 0 { pump(s, i, b, t, rd); finish(s, i, st, b, t); }
        }
        i = i + 1;
    }
    let v = slice(s.V, 16);
    let k: u64 = 0;
    while k < 16 { if v[k] != 0 { if rt_reap(i64(v[k])) >= 0 { v[k] = 0; } } k = k + 1; }
    if s.rec_pid > 0 { let c = rt_reap(s.rec_pid); if c >= 0 { records_done(s, c, b); } }
    if s.bench_pid > 0 { let c = rt_reap(s.bench_pid); if c >= 0 { s.bench_pid = 0; s.bench_st = 2; } }
    if s.running {
        let now = rt_unix_s();
        if now >= s.ends && !s.stopping { s.stopping = true; log_line(b, "time is up: finishing the running jobs"); }
        if !s.stopping {
            i = 0;
            while i < s.nw { if wv(s, i, 0) == 0 { start_job(s, i, b, t); } i = i + 1; }
        }
        if s.stopping && busy(s) == 0 {
            s.running = false;
            if s.caff > 0 { rt_kill(s.caff, 15); rt_reap(s.caff); s.caff = 0; }
            log_line(b, "hunt finished");
            save_state(s, b);
        }
    }
}

// ---------------------------------------------------------------- http
fn reply(conn: i64, code: str, ctype: str, body: *const u8, n: u64, write h: Out) {
    bz(h);
    ps(h, "HTTP/1.1 "); ps(h, code); ps(h, "\r\nContent-Type: "); ps(h, ctype);
    ps(h, "\r\nContent-Length: "); pu(h, n);
    ps(h, "\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n");
    rt_send_all(conn, h.p, h.len);
    if n > 0 { rt_send_all(conn, body, n); }
}
fn reply_msg(conn: i64, ok: bool, msg: str, write b: Out, write h: Out) {
    bz(b);
    if ok { ps(b, "{\"ok\":true,\"msg\":\""); } else { ps(b, "{\"ok\":false,\"msg\":\""); }
    ps(b, msg); ps(b, "\"}");
    reply(conn, "200 OK", "application/json", b.p, b.len, h);
}
fn jb(write o: Out, v: bool) { if v { ps(o, "true"); } else { ps(o, "false"); } }

fn status_json(write s: Srv, write b: Out) {
    bz(b);
    compute_lambda(s);
    let sc = s.scale;
    ps(b, "{\"engine\":\"praetor\",\"now\":"); pu(b, rt_unix_s());
    ps(b, ",\"running\":"); jb(b, s.running); ps(b, ",\"stopping\":"); jb(b, s.stopping);
    ps(b, ",\"started\":"); pu(b, s.started); ps(b, ",\"ends\":"); pu(b, s.ends);
    ps(b, ",\"cores\":"); pu(b, s.cores); ps(b, ",\"ncpu\":"); pu(b, s.ncpu);
    ps(b, ",\"job_secs\":"); pu(b, s.job_secs);
    ps(b, ",\"gpu\":{\"ok\":"); jb(b, s.gpu_ok); ps(b, ",\"on\":"); jb(b, s.gpu_on); ps(b, ",\"name\":\"");
    let gn = rt_gpu_name();
    let gs = slice(gn, rt_strlen(gn));
    let q: u64 = 0;
    while q < gs.len { if gs[q] != 34 && gs[q] != 92 && gs[q] >= 32 { pb(b, gs[q]); } q = q + 1; }
    ps(b, "\"},\"lambda\":"); psci(b, s.lam, 40, 4);
    ps(b, ",\"price_scale\":"); pfix(b, sc, 32, 4);
    ps(b, ",\"discoverer\":\""); pbs(b, slice(s.disc, 16), 0, s.dlen);
    ps(b, "\",\"tasks\":{\"records\":"); pu(b, s.rec_st); ps(b, ",\"bench\":"); pu(b, s.bench_st);
    let nv: u64 = 0;
    let v = slice(s.V, 16);
    q = 0;
    while q < 16 { if v[q] != 0 { nv = nv + 1; } q = q + 1; }
    ps(b, ",\"verifying\":"); pu(b, nv); ps(b, "}");
    ps(b, ",\"found_session\":"); pu(b, s.found);
    ps(b, ",\"workers\":[");
    let first = true;
    let i: u64 = 0;
    while i < MAXW() {
        if wv(s, i, 0) != 0 {
            if !first { pb(b, 44); }
            first = false;
            let ar = wv(s, i, 1);
            ps(b, "{\"id\":"); pu(b, i); ps(b, ",\"arm\":\""); arm_key(b, s, ar);
            ps(b, "\",\"P\":"); pu(b, av(s, ar, 0)); ps(b, ",\"d\":"); pu(b, av(s, ar, 1));
            ps(b, ",\"digits\":"); pu(b, av(s, ar, 24));
            ps(b, ",\"m0\":"); pu(b, wv(s, i, 2)); ps(b, ",\"M\":"); pu(b, wv(s, i, 3));
            ps(b, ",\"dry\":"); jb(b, wv(s, i, 4) == 1); ps(b, ",\"gpu\":"); jb(b, wv(s, i, 5) == 1);
            ps(b, ",\"started\":"); pu(b, wv(s, i, 6)); ps(b, ",\"tested\":"); pu(b, wv(s, i, 7));
            ps(b, ",\"completed\":"); pu(b, wv(s, i, 19));
            ps(b, ",\"last_gap\":"); pu(b, wv(s, i, 9)); ps(b, ",\"last_merit\":"); pfix(b, wv(s, i, 10), 32, 2);
            ps(b, ",\"last_done\":"); jb(b, wv(s, i, 11) == 1);
            ps(b, ",\"est_secs\":");
            let spm = av(s, ar, 14);
            if wv(s, i, 4) == 1 || spm == 0 { ps(b, "null"); } else { pu(b, spm * wv(s, i, 3) / 1000000000); }
            pb(b, 125);
        }
        i = i + 1;
    }
    ps(b, "],\"arms\":[");
    i = 0;
    while i < s.na {
        if i > 0 { pb(b, 44); }
        ps(b, "{\"key\":\""); arm_key(b, s, i);
        ps(b, "\",\"P\":"); pu(b, av(s, i, 0)); ps(b, ",\"d\":"); pu(b, av(s, i, 1));
        ps(b, ",\"digits\":"); pu(b, av(s, i, 24)); ps(b, ",\"on\":"); jb(b, av(s, i, 16) == 1);
        ps(b, ",\"priced\":"); pu(b, av(s, i, 15));
        ps(b, ",\"prior\":"); psci(b, mulsh(av(s, i, 4), sc, 32), 40, 4);
        let p = posterior(s, i, sc);
        let unpriced = av(s, i, 15) != 2 && av(s, i, 17) == 0;
        if unpriced { ps(b, ",\"est\":null,\"lo\":null,\"hi\":null"); } else {
            let sd = isqrt(p.v) << 16;
            let w = smul32(i64(sd), 7043746365);                         // 1.64 sd: a 90% band
            ps(b, ",\"est\":"); psci(b, exp_q(p.mu + i64(p.v / 2), 40), 40, 4);
            ps(b, ",\"lo\":"); psci(b, exp_q(p.mu - w, 40), 40, 4);
            ps(b, ",\"hi\":"); psci(b, exp_q(p.mu + w, 40), 40, 4);
        }
        ps(b, ",\"jobs\":"); pu(b, av(s, i, 7));
        ps(b, ",\"coreh\":"); pfix(b, muldiv(av(s, i, 6), u64(1) << 32, 3600000000000), 32, 3);
        ps(b, ",\"tested\":"); pu(b, av(s, i, 8)); ps(b, ",\"completed\":"); pu(b, av(s, i, 9));
        ps(b, ",\"hits\":"); pu(b, av(s, i, 10)); ps(b, ",\"cand\":"); pu(b, av(s, i, 11));
        ps(b, ",\"value\":"); psci(b, av(s, i, 5), 40, 4);
        ps(b, ",\"pcal\":"); pfix(b, av(s, i, 12), 40, 3); ps(b, ",\"calhits\":"); pu(b, av(s, i, 13));
        ps(b, ",\"gpu_jobs\":"); pu(b, av(s, i, 18));
        ps(b, ",\"gpu_h\":"); pfix(b, muldiv(av(s, i, 19), u64(1) << 32, 3600000000000), 32, 3);
        ps(b, ",\"gpu_value\":"); psci(b, av(s, i, 20), 40, 4);
        ps(b, ",\"gpu_tested\":"); pu(b, av(s, i, 21)); ps(b, ",\"gpu_hits\":"); pu(b, av(s, i, 22));
        pb(b, 125);
        i = i + 1;
    }
    ps(b, "]}");
}

fn default_arms(write s: Srv) {
    let ps_: [4]u64;
    ps_[0] = 4001; ps_[1] = 6007; ps_[2] = 8009; ps_[3] = 12007;
    let i: u64 = 0;
    while i < 4 { arm_add(s, ps_[i], 210); arm_add(s, ps_[i], 2310); i = i + 1; }
}

fn start_hunt(write s: Srv, body: slice u8, n: u64, write b: Out) -> bool {
    if s.running || s.bench_pid != 0 { return false; }
    if rt_file_size("records.txt") < 1000000 { return false; }
    let fc = kv(body, n, "cores");
    let fh = kv(body, n, "hours");
    let fj = kv(body, n, "job");
    let fg = kv(body, n, "gpu");
    let fa = kv(body, n, "arms");
    let cores = s.ncpu - 2;
    if s.ncpu < 3 { cores = 1; }
    if fc.hi > fc.lo { cores = num_at(body, fc.lo, fc.hi); }
    if cores < 1 { cores = 1; }
    if cores > 62 { cores = 62; }
    let hours: u64 = u64(8) << 32;
    if fh.hi > fh.lo { hours = parse_q32(body, fh.lo, fh.hi); }
    if hours < (u64(1) << 26) { hours = u64(1) << 26; }
    s.job_secs = 600;
    if fj.hi > fj.lo { s.job_secs = num_at(body, fj.lo, fj.hi); }
    if s.job_secs < 20 { s.job_secs = 20; }
    s.gpu_on = s.gpu_ok && fg.hi > fg.lo && body[fg.lo] == 49;
    // arms: "4001.210,6007.2310" -- anything missing from the list is switched off
    let i: u64 = 0;
    while i < s.na { aset(s, i, 16, 0); if av(s, i, 15) == 1 { aset(s, i, 15, 0); } i = i + 1; }
    let picked: u64 = 0;
    let j = fa.lo;
    while j < fa.hi {
        let P = num_at(body, j, fa.hi);
        while j < fa.hi && isdig(body[j]) { j = j + 1; }
        let d: u64 = 0;
        if j < fa.hi && (body[j] == 46 || body[j] == 120 || body[j] == 47) {
            j = j + 1;
            d = num_at(body, j, fa.hi);
            while j < fa.hi && isdig(body[j]) { j = j + 1; }
        }
        if P > 0 && d > 0 {
            let a = arm_add(s, P, d);
            if a < MAXA() { aset(s, a, 16, 1); picked = picked + 1; }
        }
        while j < fa.hi && !isdig(body[j]) { j = j + 1; }
    }
    if picked == 0 {
        default_arms(s);
        i = 0;
        while i < 8 { aset(s, i, 16, 1); i = i + 1; }
    }
    let wi: u64 = 0;
    while wi < MAXW() { wset(s, wi, 21, 0); wi = wi + 1; }
    s.cores = cores;
    s.nw = cores;
    if s.gpu_on { s.nw = cores + 1; }
    s.running = true;
    s.stopping = false;
    s.started = rt_unix_s();
    s.ends = s.started + mulsh(hours, 3600, 32);
    s.found = 0;
    if rt_is_darwin() == 1 && s.caff == 0 {
        bz(b);
        ps(b, "caffeinate"); pb(b, 0); ps(b, "-i"); pb(b, 0);    // keep the mac awake while hunting
        s.caff = rt_spawn(b.p, 2, 0, "", 0, "/dev/null");
    }
    bz(b);
    ps(b, "==== hunt started: "); pu(b, cores); ps(b, " cores");
    if s.gpu_on { ps(b, " + gpu"); }
    ps(b, ", "); pfix(b, hours, 32, 2); ps(b, " h, jobs of "); pu(b, s.job_secs); ps(b, " s ====");
    let msg = slice(b.p, b.cap);
    let L = b.len;
    let t = out_new(0 - 1, 256);
    let dt: [32]u8;
    dt[0] = 0;
    let dn = rt_date(&mut dt[0]);
    pb(t, 91); pbs(t, &dt[0..32], 0, dn); ps(t, "] "); pbs(t, msg, 0, L); pb(t, 10);
    rt_append("hunt.log", t.p, t.len);
    rt_free(t.p);
    save_state(s, b);
    return true;
}

fn serve_file(conn: i64, name: str, ctype: str, from: u64, cap: u64, write b: Out, write h: Out) {
    let sz = rt_file_size(name.bytes.ptr);
    if sz < 0 { reply(conn, "200 OK", ctype, "", 0, h); return; }
    let n = u64(sz);
    let st = from;
    if st > n { st = n; }
    let len = n - st;
    if len > cap { len = cap; }
    let buf = rt_alloc8(len + 1);
    let got = rt_read_at(name.bytes.ptr, st, buf, len);
    if got < 0 { got = 0; }
    bz(h);
    ps(h, "HTTP/1.1 200 OK\r\nContent-Type: "); ps(h, ctype);
    ps(h, "\r\nContent-Length: "); pu(h, u64(got));
    ps(h, "\r\nX-File-Size: "); pu(h, n);
    ps(h, "\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n");
    rt_send_all(conn, h.p, h.len);
    rt_send_all(conn, buf, u64(got));
    rt_free(buf);
}

fn http_handle(write s: Srv, conn: i64, write rq: Out, write b: Out, write h: Out, write t: Out) {
    // read the request: headers, then Content-Length bytes of body
    bz(rq);
    let r = slice(rq.p, rq.cap);
    let hend: u64 = 0;
    let clen: u64 = 0;
    let tries: u64 = 0;
    while tries < 40 {
        if rq.len + 1 >= rq.cap { tries = 40; } else {
            let got = rt_recv_ms(conn, &mut r[rq.len], rq.cap - rq.len - 1, 250);
            if got <= 0 { tries = 40; } else {
                rq.len = rq.len + u64(got);
                if hend == 0 {
                    let k: u64 = 3;
                    while k < rq.len && hend == 0 {
                        if r[k - 3] == 13 && r[k - 2] == 10 && r[k - 1] == 13 && r[k] == 10 { hend = k + 1; }
                        k = k + 1;
                    }
                    if hend > 0 {
                        // content-length (any case)
                        let k2: u64 = 0;
                        while k2 + 15 < hend {
                            if (r[k2] == 67 || r[k2] == 99) && (r[k2 + 8] == 76 || r[k2 + 8] == 108) && r[k2 + 14] == 58 {
                                let v = k2 + 15;
                                while v < hend && r[v] == 32 { v = v + 1; }
                                clen = num_at(r, v, hend);
                            }
                            k2 = k2 + 1;
                        }
                    }
                }
                if hend > 0 && rq.len >= hend + clen { tries = 40; }
            }
        }
        tries = tries + 1;
    }
    if hend == 0 { rt_close_fd(conn); return; }
    let post = starts(r, rq.len, 0, "POST ");
    let p0: u64 = 4;
    if post { p0 = 5; }
    let p1 = p0;
    while p1 < hend && r[p1] != 32 && r[p1] != 63 { p1 = p1 + 1; }
    let q0 = p1;
    let q1 = p1;
    if p1 < hend && r[p1] == 63 { q0 = p1 + 1; q1 = q0; while q1 < hend && r[q1] != 32 { q1 = q1 + 1; } }
    let body = &r[hend..rq.cap];
    let bl = rq.len - hend;
    if !post && eqs(r, p0, p1, "/research") {
        serve_file(conn, "research.html", "text/html; charset=utf-8", 0, 1 << 24, b, h);
        rt_close_fd(conn); return;
    }
    if !post && eqs(r, p0, p1, "/research.json") {
        serve_file(conn, "learning/summary.json", "application/json", 0, 1 << 24, b, h);
        rt_close_fd(conn); return;
    }
    if !post && eqs(r, p0, p1, "/calibration.json") {
        serve_file(conn, "learning/calibration.json", "application/json", 0, 1 << 24, b, h);
        rt_close_fd(conn); return;
    }
    if !post {
        if eqs(r, p0, p1, "/") || eqs(r, p0, p1, "/index.html") {
            serve_file(conn, "ui.html", "text/html; charset=utf-8", 0, 1 << 24, b, h);
        } else { if eqs(r, p0, p1, "/api/status") {
            status_json(s, b);
            reply(conn, "200 OK", "application/json", b.p, b.len, h);
        } else { if starts(r, p1, p0, "/data/") {
            let qs = &r[q0..q1];
            let fr = kv(qs, q1 - q0, "from");
            let from: u64 = 0;
            if fr.hi > fr.lo { from = num_at(qs, fr.lo, fr.hi); }
            let cap: u64 = 4194304;
            let n0 = p0 + 6;
            if eqs(r, n0, p1, "gaps.tsv") { serve_file(conn, "gaps.tsv", "text/plain", from, cap, b, h); }
            else { if eqs(r, n0, p1, "FOUND.tsv") { serve_file(conn, "FOUND.tsv", "text/plain", from, cap, b, h); }
            else { if eqs(r, n0, p1, "VERIFIED.tsv") { serve_file(conn, "VERIFIED.tsv", "text/plain", from, cap, b, h); }
            else { if eqs(r, n0, p1, "jobs.tsv") { serve_file(conn, "jobs.tsv", "text/plain", from, cap, b, h); }
            else { if eqs(r, n0, p1, "hunt.log") { serve_file(conn, "hunt.log", "text/plain", from, cap, b, h); }
            else { if eqs(r, n0, p1, "table.tsv") { serve_file(conn, "table.tsv", "text/plain", from, cap, b, h); }
            else { if eqs(r, n0, p1, "submitted.txt") { serve_file(conn, "submitted.txt", "text/plain", from, cap, b, h); }
            else { if eqs(r, n0, p1, "bench.txt") { serve_file(conn, "bench.txt", "text/plain", from, cap, b, h); }
            else { reply(conn, "404 Not Found", "text/plain", "", 0, h); } } } } } } } }
        } else { if eqs(r, p0, p1, "/favicon.ico") {
            reply(conn, "204 No Content", "image/x-icon", "", 0, h);
        } else {
            reply(conn, "404 Not Found", "text/plain", "", 0, h);
        } } } }
        rt_close_fd(conn);
        return;
    }
    if eqs(r, p0, p1, "/api/start") {
        let had_table = rt_file_size("records.txt") >= 1000000;
        if start_hunt(s, body, bl, b) { tick(s, b, t, h); reply_msg(conn, true, "hunt started", b, h); }
        else { if had_table { reply_msg(conn, false, "a hunt is already running", b, h); }
               else { start_records(s, b); reply_msg(conn, false, "records.txt is missing: fetching the live table, start again in a minute", b, h); } }
    } else { if eqs(r, p0, p1, "/api/stop") {
        if !s.running { reply_msg(conn, false, "nothing is running", b, h); } else {
            s.stopping = true;
            let fnow = kv(body, bl, "now");
            if fnow.hi > fnow.lo && body[fnow.lo] == 49 {
                let i: u64 = 0;
                while i < MAXW() { if wv(s, i, 0) != 0 { wset(s, i, 20, 1); rt_kill(i64(wv(s, i, 0)), 15); } i = i + 1; }
                log_line(b, "stop now: workers killed");
                reply_msg(conn, true, "stopping now", b, h);
            } else {
                log_line(b, "stop requested: finishing the running jobs");
                reply_msg(conn, true, "stopping after the running jobs finish", b, h);
            }
        }
    } else { if eqs(r, p0, p1, "/api/records") {
        start_records(s, b);
        reply_msg(conn, true, "downloading the live record table", b, h);
    } else { if eqs(r, p0, p1, "/api/verify") {
        let n = verify_pending(s, b);
        if n == 0 { reply_msg(conn, true, "everything is already verified", b, h); }
        else { reply_msg(conn, true, "verifying in the background", b, h); }
    } else { if eqs(r, p0, p1, "/api/bench") {
        let probe = kv(body, bl, "probe");
        if s.running || s.bench_pid != 0 {
            reply_msg(conn, false, "stop the hunt or wait for the current tool to finish", b, h);
            rt_close_fd(conn);
            return;
        }
        if s.bench_pid == 0 {
            bz(b);
            ps(b, "hunter"); pb(b, 0);
            let argc: i32 = 5;
            if probe.hi > probe.lo {
                let fp = kv(body, bl, "P");
                let ft = kv(body, bl, "target");
                let P = num_at(body, fp.lo, fp.hi);
                let target = num_at(body, ft.lo, ft.hi);
                if P < 211 || P > 4001 || target < 1 || target > 100 {
                    reply_msg(conn, false, "choose P 211..4001 and target 1..100", b, h);
                    rt_close_fd(conn); return;
                }
                ps(b, "probe"); pb(b, 0); pu(b, P); pb(b, 0);
                ps(b, "210"); pb(b, 0); ps(b, "64"); pb(b, 0); pu(b, target); pb(b, 0);
                argc = 6;
            } else {
                ps(b, "bench"); pb(b, 0); ps(b, "4001"); pb(b, 0); ps(b, "210"); pb(b, 0); ps(b, "4096"); pb(b, 0);
            }
            s.bench_pid = rt_spawn(b.p, argc, 1, "", 0, "bench.txt");
            if s.bench_pid <= 0 { s.bench_pid = 0; reply_msg(conn, false, "could not start tool", b, h); rt_close_fd(conn); return; }
            s.bench_st = 1;
        }
        reply_msg(conn, true, "tool started; output appears below", b, h);
    } else { if eqs(r, p0, p1, "/api/submitted") {
        let fg = kv(body, bl, "gap");
        if fg.hi > fg.lo {
            bz(b); pu(b, num_at(body, fg.lo, fg.hi)); pb(b, 10);
            rt_append("submitted.txt", b.p, b.len);
        }
        reply_msg(conn, true, "marked as submitted", b, h);
    } else { if eqs(r, p0, p1, "/api/config") {
        let fd = kv(body, bl, "discoverer");
        let dd = slice(s.disc, 16);
        let k: u64 = 0;
        let j = fd.lo;
        while j < fd.hi && k < 8 {
            let c = body[j];
            if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || isdig(c) || c == 46 || c == 45 || c == 95 { dd[k] = c; k = k + 1; }
            j = j + 1;
        }
        if k >= 3 {
            s.dlen = k;
            rt_write_atomic("config.txt", s.disc, k);
            reply_msg(conn, true, "saved", b, h);
        } else { reply_msg(conn, false, "discoverer must be 3-8 letters", b, h); }
    } else {
        reply(conn, "404 Not Found", "text/plain", "", 0, h);
    } } } } } } }
    rt_close_fd(conn);
}

fn cmd_serve() -> i32 {
    rt_server_init();
    rt_chdir_exe();
    rt_mkdir("run");
    let pv = process.env("HUNTER_PORT");
    let port_s = arg_or(2, "8765");
    let port_n = parse_num(port_s);
    match pv { Ok(v) => { port_n = parse_num(v); } Err(e) => {} }
    if port_n == 0 { port_n = 8765; }
    let s = Srv {
        A: rt_alloc64(MAXA() * AS()), na: 0, W: rt_alloc64(MAXW() * WS()), nw: 0,
        LN: rt_alloc8(MAXW() * LB()), SM: rt_alloc8(MAXW() * 2048), V: rt_alloc64(16),
        running: false, stopping: false, ends: 0, started: 0, cores: 0,
        gpu_ok: rt_gpu_available() == 1, gpu_on: false, job_secs: 600, lam: 0, scale: u64(1) << 31, caff: 0,
        rng: rt_now_ns() ^ (u64(rt_getpid()) << 32) ^ 88172645463325252,
        rec_pid: 0, rec_st: 0, bench_pid: 0, bench_st: 0,
        disc: rt_alloc8(16), dlen: 0, ncpu: u64(rt_ncpu()), port: port_n, found: 0,
    };
    let dd = slice(s.disc, 16);
    let dflt: str = "B.Rouyea";
    let k: u64 = 0;
    while k < dflt.len { dd[k] = dflt.bytes[k]; k = k + 1; }
    s.dlen = dflt.len;
    let cn = rt_read_at("config.txt", 0, s.disc, 8);
    if cn >= 3 { s.dlen = u64(cn); }
    let b0 = out_new(0 - 1, 1 << 12);
    load_state(s);
    default_arms(s);
    if rt_file_size("records.txt") <= 0 {
        io.eprintln("hunter: records.txt is missing -- fetching the live record table now");
        start_records(s, b0);
    }
    let lfd = net.tcp_socket();
    rt_cloexec(lfd);
    net.reuse_addr_raw(lfd);
    if net.bind_v4(lfd, net.loopback_v4(), u16(port_n)) != 0 {
        io.eprint("hunter: port "); io.println_i64(i64(port_n)); io.eprintln("hunter: could not bind (already running?)");
        return 1;
    }
    net.listen_raw(lfd, 64);
    let b = out_new(0 - 1, 1 << 16);
    let t = out_new(0 - 1, 1 << 12);
    let h = out_new(0 - 1, 1 << 12);
    let rq = out_new(0 - 1, 1 << 16);
    let rd = out_new(0 - 1, 1 << 16);
    io.print("the hunter (praetor) -- control room on http://localhost:");
    io.println_i64(i64(port_n));
    if s.gpu_ok { io.print("gpu: "); let gn = rt_gpu_name(); let gs = slice(gn, rt_strlen(gn)); let o = out_new(1, 256); pbs(o, gs, 0, gs.len); pb(o, 10); flush(o); }
    io.println("ctrl-c stops everything (running jobs are killed, records already found are safe in FOUND.tsv)");
    log_line(b, "control room started");
    if rt_is_darwin() == 1 {
        let no = process.env("HUNTER_NO_OPEN");
        let open_it = true;
        match no { Ok(v) => { open_it = false; } Err(e) => {} }
        if open_it {
            bz(b);
            ps(b, "open"); pb(b, 0); ps(b, "http://localhost:"); pu(b, port_n); pb(b, 0);
            let op = rt_spawn(b.p, 2, 0, "", 0, "/dev/null");
            rt_reap(op);
        }
    }
    let last: u64 = 0;
    while rt_quit_requested() == 0 {
        let conn = rt_accept_ms(lfd, 200);
        if conn >= 0 { http_handle(s, conn, rq, b, h, t); }
        let now = rt_now_ns();
        if now - last > 200000000 { tick(s, b, t, rd); last = now; }
    }
    // ctrl-c: the terminal already signalled the workers (same process group); drain what they wrote
    let i: u64 = 0;
    while i < MAXW() { if wv(s, i, 0) != 0 { wset(s, i, 20, 1); rt_kill(i64(wv(s, i, 0)), 15); } i = i + 1; }
    rt_sleep_ms(300);
    i = 0;
    while i < MAXW() {
        if wv(s, i, 0) != 0 { pump(s, i, b, t, rd); let st = rt_reap(i64(wv(s, i, 0))); finish(s, i, st, b, t); }
        i = i + 1;
    }
    if s.caff > 0 { rt_kill(s.caff, 15); }
    save_state(s, b);
    log_line(b, "control room stopped");
    io.println("bye. state saved.");
    return 0;
}

// ---------------------------------------------------------------- verify: an independent check
// hunter verify "m*P#/d-a" gap   ->  BPSW-style checks on both ends + nextprime(p) == p + gap
fn cmd_verify() -> i32 {
    let ex = arg_or(2, "");
    let gap = parse_num(arg_or(3, "0"));
    let e = ex.bytes;
    let m = num_at(e, 0, e.len);
    let i = skip_digits(e, 0) + 1;                  // past '*'
    let P = num_at(e, i, e.len);
    i = skip_digits(e, i) + 2;                      // past '#/'
    let d = num_at(e, i, e.len);
    i = skip_digits(e, i) + 1;                      // past '-'
    let a = num_at(e, i, e.len);
    let o = out_new(1, 4096);
    if m == 0 || P == 0 || d == 0 || gap == 0 { ps(o, "usage: hunter verify m*P#/d-a gap\n"); flush(o); return 1; }
    let p = rt_mpz(); let q = rt_mpz(); let np = rt_mpz();
    __gmpz_primorial_ui(p, P);
    __gmpz_mul_ui(p, p, m);
    let ok = __gmpz_divisible_ui_p(p, d) != 0;
    if ok {
        __gmpz_divexact_ui(p, p, d);
        __gmpz_sub_ui(p, p, a);
        __gmpz_add_ui(q, p, gap);
        ok = __gmpz_probab_prime_p(p, 25) != 0 && __gmpz_probab_prime_p(q, 25) != 0;
        if ok { __gmpz_nextprime(np, p); ok = __gmpz_cmp(np, q) == 0; }
    }
    let b = out_new(0 - 1, 512);
    pu(b, gap); ps(b, "\t-\t"); pbs(b, e, 0, e.len); tab(b);
    if ok { ps(b, "OK\n"); } else { ps(b, "FAILED\n"); }
    rt_append("VERIFIED.tsv", b.p, b.len);
    pbs(o, slice(b.p, b.cap), 0, b.len);
    flush(o);
    if ok { return 0; }
    return 2;
}

extern fn rt_probe(m: u64, q: u64, ln: u64, target: u64, right: *u32, nr: u64, left: *u32, nl: u64, nanos: u64);
extern fn rt_pattern(m: u64, right: *u32, nr: u64, left: *u32, nl: u64);

fn cmd_probe() -> i32 {
    let c = new_ctx();
    c.P = parse_num(arg_or(2, "337"));
    c.d = parse_num(arg_or(3, "210"));
    c.M = parse_num(arg_or(4, "64"));
    let target = parse_num(arg_or(5, "43"));
    if c.P < 211 || c.P > 4001 || c.d < 1 || c.M < 1 || c.M > 256 || target < 1 || target > 100 {
        io.eprintln("probe: P 211..4001, d dividing P#, centers 1..256, merit 1..100");
        return 1;
    }
    c.m0 = parse_num(arg_or(6, "10000001"));
    c.L = parse_num(arg_or(7, "1000000"));
    if c.m0 < 1 || c.m0 > 1000000000000 || c.L < c.P || c.L > 10000000 {
        io.eprintln("probe: start 1..1000000000000, sieve P..10000000");
        return 1;
    }
    let patterns = false;
    let pv = process.env("HUNTER_PATTERNS");
    match pv { Ok(v) => { patterns = v == "1"; } Err(e) => {} }
    c.SL = target * c.P;
    engine_setup(c, "records.txt");
    let o = out_new(1, 4096);
    ps(o, "target-merit probe: model estimates, not a hunt\nP="); pu(o, c.P);
    ps(o, " d="); pu(o, c.d); ps(o, " target="); pu(o, target);
    ps(o, " sieve="); pu(o, c.L); pb(o, 10);
    ps(o, "log10 probability: -12 means one in a trillion under the model.\n");
    ps(o, "rate excludes sieve/setup costs and assumes both sides tested on one CPU core.\n");
    ps(o, "finite-window endpoints only; no claim of calibration at this target.\n");
    ps(o, "m\tlog10(probability)\texpected tests\tlog10(hits/CPU-hour)\n");
    flush(o);
    let right = slice(c.R, c.SL + 2);
    let left = slice(c.Lf, c.SL + 2);
    let b: u64 = 0;
    while b < c.M {
        let count = c.M - b; if count > c.MB { count = c.MB; }
        sieve_block(c, c.m0 + b, count);
        let bits = slice(c.bits, count * 2 * c.words);
        let k: u64 = 0;
        while k < count {
            let m = c.m0 + b + k;
            if gcd64(m, c.d) == 1 {
                let nr: u64 = 0; let nl: u64 = 0; let off: u64 = 1;
                while off <= c.SL {
                    let base = k * 2 * c.words;
                    if ((bits[base + (off >> 6)] >> (off & 63)) & 1) == 0 { right[nr] = u32(off); nr = nr + 1; }
                    if ((bits[base + c.words + (off >> 6)] >> (off & 63)) & 1) == 0 { left[nl] = u32(off); nl = nl + 1; }
                    off = off + 1;
                }
                let ln = c.lnK + ln_q32(m);
                let q = divpow2(94, mulsh(ln, c.lprod, 62));
                rt_probe(m, q, ln, target, c.R, nr, c.Lf, nl, c.tprp);
                if patterns { rt_pattern(m, c.R, nr, c.Lf, nl); }
            }
            k = k + 1;
        }
        b = b + count;
    }
    io.println("probe complete; no hunt started and no finds written");
    return 0;
}

fn main() -> i32 {
    let cmd = arg_or(1, "serve");
    if cmd == "serve" { return cmd_serve(); }
    if cmd == "hunt" { return cmd_hunt(); }
    if cmd == "bench" { return cmd_bench(); }
    if cmd == "probe" { return cmd_probe(); }
    if cmd == "verify" { return cmd_verify(); }
    io.println("the hunter (praetor)");
    io.println("  hunter                        the control room on http://localhost:8765 (same as: hunter serve)");
    io.println("  hunter serve [port]");
    io.println("  hunter bench [P d count]      cpu vs gpu prime-test throughput, and a math check against gmp");
    io.println("  hunter verify m*P#/d-a gap    independent check of one gap");
    io.println("  hunter hunt P d m0 M SL L lambda mcal records.txt    one engine job (what the workers run)");
    return 0;
}
